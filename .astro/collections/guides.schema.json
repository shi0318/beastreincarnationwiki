{
  "$ref": "#/definitions/guides",
  "definitions": {
    "guides": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "boss",
            "enemies",
            "exploration",
            "combat",
            "beginner"
          ]
        },
        "keyword": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "updateDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "order": {
          "type": "number",
          "default": 50
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "preview": {
          "type": "boolean",
          "default": false
        },
        "source": {
          "type": "string",
          "enum": [
            "official",
            "trailer",
            "analysis",
            "lore",
            "speculation"
          ],
          "default": "speculation"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "keyword",
        "image",
        "imageAlt",
        "publishDate"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}