---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, GAME_FACTS } from '../data/site';

const path = '/disclaimer/';
const title = 'Disclaimer & Editorial Policy';
const description =
  'How Beast of Reincarnation Wiki handles official facts, shipped-game coverage, historical material, affiliate independence, and corrections.';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: new URL(path, SITE.url).href,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Disclaimer', item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path}>
  <JsonLd slot="head" schema={schema} />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-ash-400">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-ember-400">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ash-300">Disclaimer</li>
      </ol>
    </nav>

    <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
      Disclaimer & Editorial Policy
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ash-300">
      Beast of Reincarnation released on {GAME_FACTS.releaseDate}. This page explains how we separate
      confirmed store information, shipped-game coverage, and historical material.
    </p>

    <div class="prose mt-10 max-w-none">
      <h2>Unofficial fan resource</h2>
      <p>
        {SITE.name} is an unofficial, fan-made website. We are not affiliated with, sponsored by, or
        endorsed by {GAME_FACTS.developer}, {GAME_FACTS.publisher}, Steam, Valve, or any related rights holder.
        All trademarks remain the property of their respective owners.
      </p>

      <h2>How we label sources</h2>
      <p>
        Confirmed release, systems, pricing, language, and hardware details come from the official
        Steam listing and first-party announcements, and are labeled <strong>Official</strong>. Guides
        describing the shipped game are labeled <strong>Hands-on</strong> and name the post-launch
        coverage each detail came from at the bottom of the page — that label means sourced and
        attributed, not that we personally cleared every fight. Historical trailer and launch-period
        material is kept as context only; it is never silently promoted to a current combat or route
        result.
      </p>

      <h2>What we will not claim</h2>
      <ul>
        <li>Exact frame data, damage numbers, or drop tables as verified facts</li>
        <li>Boss clears or routes we have neither performed nor found a source for</li>
        <li>Full maps, puzzle solutions, or item locations as complete</li>
        <li>Tier lists or "best build" rankings, which no published source supports yet</li>
      </ul>

      <h2>Keeping released-game pages current</h2>
      <p>
        The game is out, so current pages use their latest checked date and retain a clear boundary
        around official facts, post-launch coverage, player reports, and historical material. The
        {' '}<a href="/guides/launch-day-beginner-guide/">beginner's guide</a> and the
        {' '}<a href="/guides/nushi-boss-fight/">Rangifer Nushi guide</a> are the pages currently
        written around the released combat loop.
      </p>

      <h2>Corrections</h2>
      <p>
        If you spot an error in a confirmed fact, or a claim on a guide page that does not match the
        shipped game, please <a href="/contact/">contact us</a>. We prioritize corrections to official
        data first.
      </p>

      <h2>External links</h2>
      <p>
        Links to Steam or other official sources are provided for verification. We do not control third-party
        pages and their content may change without notice.
      </p>
    </div>
  </section>
</BaseLayout>
