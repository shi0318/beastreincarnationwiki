---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import WikiSectionCard from '../components/WikiSectionCard.astro';
import WikiSectionNav from '../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../data/site';

const path = '/characters/';
const title = 'Beast of Reincarnation Characters: Emma and Koo Guide';
const description =
  'Beast of Reincarnation characters guide covering Emma and Koo, their story roles, combat jobs, skill trees and links to build and Bloom Art guides.';
const image = '/images/beast-of-reincarnation-koo-blighted-wolf.webp';
const canonical = new URL(path, SITE.url).href;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: canonical,
    about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: { '@type': 'ItemList', numberOfItems: 2, itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Emma', url: new URL('/characters/emma/', SITE.url).href },
      { '@type': 'ListItem', position: 2, name: 'Koo', url: new URL('/characters/koo/', SITE.url).href },
    ] },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: 'Characters', item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path} image={image} imageAlt="Koo, the blighted dog companion, in Beast of Reincarnation">
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30"><div class="mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400"><a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span><a href="/guides/" class="hover:text-ember-400">Guides</a><span aria-hidden="true"> / </span><span class="text-ash-300">Characters</span></nav>
    <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">Beast of Reincarnation Characters: Emma and Koo Guide</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">Beast of Reincarnation is built around two playable partners: Emma's direct sword and movement tools, and Koo's commanded techniques and Bloom Arts. Use these character pages to find the correct skill, build and combat explanations without mixing their resources together.</p>
  </div></section>
  <main class="mx-auto max-w-6xl px-4 py-12">
    <WikiSectionNav active={path} />
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <WikiSectionCard href="/characters/emma/" label="Playable character" title="Beast of Reincarnation Emma Guide" description="Emma's sword, ranged options, Hair movement, Entanglement Overdrive and early skill priorities." />
      <WikiSectionCard href="/characters/koo/" label="Companion" title="Beast of Reincarnation Koo Guide" description="Koo's Pounce, Guard, Incantation, Bloom Arts, FP loop and support choices." />
    </div>
    <section class="mt-12 rounded-xl border border-ash-800 bg-ash-900/40 p-6">
      <h2 class="font-display text-2xl font-bold text-ash-50">How Emma and Koo work together</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-ash-300">The official Steam description presents Emma and Koo as a single combat unit: Emma uses sword abilities while the player commands Koo's techniques in a hybrid real-time and turn-based system. The practical guides below keep those roles separate so you can identify whether a problem needs a weapon change, an Emma skill, a Koo Bloom Art or a better parry-to-resource loop.</p>
      <div class="mt-5 flex flex-wrap gap-3 text-sm"><a class="rounded-lg border border-ash-700 px-4 py-2 text-ember-400 hover:border-ember-500" href="/skills/">Browse Beast of Reincarnation skills and builds</a><a class="rounded-lg border border-ash-700 px-4 py-2 text-ember-400 hover:border-ember-500" href="/guides/gameplay-guide/">Read the combat systems guide</a></div>
    </section>
    <p class="mt-8 border-t border-ash-800 pt-5 text-sm leading-relaxed text-ash-500">Official character premise checked August 17, 2026 against the <a class="text-ember-400 hover:text-ember-300" href={GAME_FACTS.source} rel="noopener" target="_blank">Beast of Reincarnation Steam page</a>. Skill recommendations remain attributed to the cited guide sources on each page.</p>
  </main>
</BaseLayout>
