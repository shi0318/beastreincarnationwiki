---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../data/site';

const path = '/contact/';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: `Contact ${SITE.name}`,
    url: new URL(path, SITE.url).href,
    description: `Get in touch with ${SITE.name} - corrections, guide suggestions, and feedback on our Beast of Reincarnation guides.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout
  title="Contact Us"
  description={`Get in touch with ${SITE.name}. Report an error, suggest a guide, or send feedback about our Beast of Reincarnation guide coverage.`}
  path={path}
>
  <JsonLd slot="head" schema={schema} />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-ash-400">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-ember-400">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ash-300">Contact</li>
      </ol>
    </nav>

    <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
      Contact Us
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ash-300">
      Spotted an error, have a correction, or want to suggest a guide we haven't
      written yet? We read every message and use your feedback to keep the wiki
      accurate and useful.
    </p>

    <div class="mt-10 rounded-xl border border-ash-800 bg-ash-900/50 p-6 md:p-8">
      <h2 class="font-display text-lg font-semibold text-ash-50">Email us</h2>
      <p class="mt-2 text-ash-400">
        The fastest way to reach us is by email. We aim to reply within a few days.
      </p>
      <a
        href={`mailto:${SITE.email}`}
        class="mt-4 inline-flex items-center gap-2 rounded-lg bg-ember-600 px-5 py-3 font-semibold text-ash-950 transition-colors hover:bg-ember-500"
      >
        {SITE.email}
      </a>
    </div>

    <div class="prose mt-10 max-w-none">
      <h2>What to include</h2>
      <p>
        To help us act on your message quickly, it helps to include:
      </p>
      <ul>
        <li><strong>Corrections</strong> - the guide URL and what you believe is inaccurate, ideally with what you saw in-game.</li>
        <li><strong>Guide requests</strong> - the boss, enemy, region, or mechanic you'd like covered.</li>
        <li><strong>General feedback</strong> - anything about the site that worked well or got in your way.</li>
      </ul>

      <h2>A note on scope</h2>
      <p>
        {SITE.name} is an unofficial, fan-made resource. We can't help with
        account issues, purchases, or technical support for the game itself  - 
        those need to go through the game's official channels. For anything about
        our guides and this site, though, we'd love to hear from you.
      </p>
    </div>
  </section>
</BaseLayout>
