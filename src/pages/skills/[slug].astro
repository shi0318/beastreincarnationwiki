---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import WikiSectionNav from '../../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../../data/site';
import { SKILL_DETAILS } from '../../data/section-pages';

export function getStaticPaths() {
  return SKILL_DETAILS.map((skill) => ({ params: { slug: skill.slug }, props: { skill } }));
}

const { skill } = Astro.props;
const path = `/skills/${skill.slug}/`;
const canonical = new URL(path, SITE.url).href;
const schema = [
  { '@context': 'https://schema.org', '@type': 'Article', headline: skill.title, description: skill.description, url: canonical, image: new URL(skill.image, SITE.url).href, about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source }, isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url }, { '@type': 'ListItem', position: 2, name: 'Skills & Builds', item: new URL('/skills/', SITE.url).href }, { '@type': 'ListItem', position: 3, name: skill.title, item: canonical }] },
];
---

<BaseLayout title={skill.title} description={skill.description} path={path} image={skill.image} imageAlt={skill.imageAlt} ogType="article" updateDate={new Date('2026-08-17T00:00:00Z')}>
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30"><div class="mx-auto max-w-5xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400"><a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span><a href="/skills/" class="hover:text-ember-400">Skills &amp; Builds</a><span aria-hidden="true"> / </span><span class="text-ash-300">{skill.character}</span></nav>
    <SourceBadge source="community" showBlurb />
    <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">{skill.title}</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">{skill.intro}</p>
  </div></section>
  <main class="mx-auto max-w-5xl px-4 py-12"><WikiSectionNav active="/skills/" />
    <section class="mt-10 grid gap-8 md:grid-cols-[1.1fr_.9fr]"><div><h2 class="font-display text-2xl font-bold text-ash-50">Beast of Reincarnation {skill.character} skill facts</h2><div class="mt-5 overflow-hidden rounded-xl border border-ash-800"><table class="w-full text-left text-sm"><tbody>{skill.facts.map((fact) => <tr class="border-t border-ash-800 first:border-t-0"><th scope="row" class="w-2/5 bg-ash-900/60 px-4 py-3 font-medium text-ash-200">{fact.label}</th><td class="px-4 py-3 text-ash-300">{fact.value}</td></tr>)}</tbody></table></div></div><img src={skill.image} alt={skill.imageAlt} width="1600" height="900" loading="eager" fetchpriority="high" class="rounded-xl border border-ash-800 object-cover" /></section>
    <section class="mt-12"><h2 class="font-display text-2xl font-bold text-ash-50">How to plan the Beast of Reincarnation {skill.character} tree</h2><ol class="mt-5 space-y-4 text-ash-300">{skill.checklist.map((item, index) => <li class="flex gap-3"><span class="font-display font-bold text-ember-400">{index + 1}.</span><span>{item}</span></li>)}</ol></section>
    <section class="mt-12 rounded-xl border border-ash-800 bg-ash-900/40 p-6"><h2 class="font-display text-xl font-bold text-ash-50">Evidence boundary</h2><p class="mt-3 leading-relaxed text-ash-300">{skill.evidence}</p></section>
    <section class="mt-12 border-t border-ash-800 pt-6 text-sm leading-relaxed text-ash-400"><h2 class="font-display text-xl font-bold text-ash-200">Sources</h2><p class="mt-2">Achievement names and progression boundaries are from <a class="text-ember-400 hover:text-ember-300" href="https://steamcommunity.com/sharedfiles/filedetails/?id=3777472649" rel="noopener" target="_blank">Steam Community guide 3777472649</a>. The combat premise and skill-tree existence are confirmed by the <a class="text-ember-400 hover:text-ember-300" href={GAME_FACTS.source} rel="noopener" target="_blank">official Beast of Reincarnation Steam listing</a>. Checked August 17, 2026.</p></section>
  </main>
</BaseLayout>
