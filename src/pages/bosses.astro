---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceBadge from '../components/SourceBadge.astro';
import WikiSectionNav from '../components/WikiSectionNav.astro';
import DetailEntry from '../components/DetailEntry.astro';
import { GAME_FACTS, SITE } from '../data/site';
import { BOSS_DETAILS } from '../data/section-pages';

// Single-boss pages (/bosses/<slug>/) were merged into this hub on 2026-11-16; their URLs
// 301 here and every boss keeps an #<slug> anchor below.
const BOSS_LINKS: Record<string, { href: string; label: string }[]> = {
  rangifer: [
    { href: '/guides/nushi-boss-fight/', label: 'Full Rangifer fight guide' },
  ],
  lacerta: [
    { href: '/weapons/blades/#thunderwave-sword', label: 'Thunderwave Sword' },
  ],
  'kunai-and-kirin': [
    { href: '/guides/beast-of-reincarnation-kunai/', label: 'Who Kunai is' },
    { href: '/weapons/blades/#camellia', label: 'Camellia blade' },
  ],
  'shidou-and-nue': [
    { href: '/guides/beast-of-reincarnation-shidou/', label: 'Who Shidou is' },
    { href: '/weapons/blades/#black-blossom', label: 'Black Blossom blade' },
  ],
  'final-boss': [{ href: '/guides/ending-story-achievements/', label: 'Ending achievements' }],
};

const path = '/bosses/';
const title = 'Beast of Reincarnation Bosses: All Steam-Confirmed Bosses';
const description =
  'Beast of Reincarnation boss list from official Steam achievement data: the six Nushi, Koo de Grace, Shidou & Nue and Kunai & Kirin, with global unlock rates and fight guides.';
const image = '/images/beast-of-reincarnation-nushi-boss-fight.webp';
const canonical = new URL(path, SITE.url).href;

// 全部名字与解锁率来自 Steam 官方成就页（App 2001760）快照 2026-09-08。
const nushi = [
  { name: 'Rangifer', slug: 'rangifer', achievement: "Rangifer's End", rate: '53.5%', guide: '#rangifer', note: 'Fought twice: crater fight (level 9, one stage) and sealed-lair rematch (level 12, two stages). Weak to fire in both.' },
  { name: 'Lacerta', slug: 'lacerta', achievement: "Lacerta's End", rate: '43.8%', guide: '#lacerta', note: 'Chapter 2, Ancient Civilization Zone (levels 13 and 16). Weak to Shock; inflicts Poison and Slow. The biggest attrition step on Steam.' },
  { name: 'Taurus', slug: 'taurus', achievement: "Taurus's End", rate: '34.8%', guide: '#taurus', note: 'Chapter 4, Pilgrim\'s Zone. Fought twice (about level 26 and 29). Weak to acid; rewards the Charging Botan Nushi skill.' },
  { name: 'Corvus', slug: 'corvus', achievement: "Corvus's End", rate: '28.3%', guide: '#corvus', note: 'Chapter 7, Giant Tree Zone. Two airborne crows back to back; weak to ranged attacks and Rangifer\'s restraint.' },
  { name: 'Ursa', slug: 'ursa', achievement: "Ursa's End", rate: '25.0%', guide: '#ursa', note: 'Chapter 10 forest lair, level 46. Weak to corrosives, acid and Restrain; sheds its shell into a flower form for phase two.' },
  { name: 'Erymanth', slug: 'erymanth', achievement: "Erymanth's End", rate: '24.6%', guide: '#erymanth', note: 'Chapter 12, the Capital, level 47. Weak to explosives; never parry its red-flash charge.' },
] as const;

const otherBosses = [
  { name: 'Koo de Grace', achievement: 'Koo de Grace', rate: '25.6%', note: 'A co-op finisher achievement listed among the combat entries; the site does not claim it is a conventional boss fight.' },
  { name: 'Shidou & Nue', achievement: 'Shidou & Nue', rate: '24.8%', guide: '#shidou-and-nue', note: 'Chapter 11 duo fight on Mount Hiei. Weak to poison; use the health-siphon trick. Rewards Black Blossom.' },
  { name: 'Kunai & Kirin', achievement: 'Kunai & Kirin', rate: '24.5%', guide: '#kunai-and-kirin', note: 'Scripted loss in Chapter 8, real fight in Chapter 12 (level 49). Weak to poison.' },
  { name: 'Nue Malefact & Male Purifier', achievement: '—', rate: '—', guide: '#nue-malefact', note: 'Chapter 3 pursuit across the Great Wall Terraces, ending in a level-20 duo fight. Weak to poison.' },
  { name: 'Final boss (Chapter 13)', achievement: 'The End of Reincarnation', rate: '—', guide: '#final-boss', note: 'Nanite Shield, then an enraged final phase. No elemental weakness.' },
  { name: 'Horror in the Sky', achievement: 'Horror in the Sky', rate: '18.3%', note: 'Non-Nushi combat achievement; tracked on the Wasteland Colossal page.' },
  { name: 'The Sealer', achievement: 'The Sealer', rate: '21.5%', note: 'Non-Nushi combat achievement outside the Nushi set.' },
] as const;

// Story order and roster folded in from the former nushi-order / nushi-boss-list guides (2026-11-16).
const order = [
  { slug: 'rangifer', name: 'Rangifer', type: 'Reindeer', chapter: '1 – Ogouchi Buffer Zone', level: '9, rematch 12' },
  { slug: 'lacerta', name: 'Lacerta', type: 'Newt / lizard', chapter: '2 – Ancient Civilization Zone', level: '13, rematch 16' },
  { slug: 'nue-malefact', name: 'Nue Malefact + Male Purifier', type: 'Yokai chimera', chapter: '3 – Great Wall Terraces', level: '16–20' },
  { slug: 'taurus', name: 'Taurus', type: 'Bull', chapter: "4 – Pilgrim's Zone", level: '~26, rematch ~29' },
  { slug: 'corvus', name: 'Corvus', type: 'Crow (two)', chapter: '7 – Giant Tree Zone', level: '–' },
  { slug: 'kunai-and-kirin', name: 'Kunai and Kirin (scripted)', type: 'Swordswoman + Kirin', chapter: '8 – Crater Zone', level: '45' },
  { slug: 'ursa', name: 'Ursa', type: 'Bear', chapter: '10 – forest lair', level: '46' },
  { slug: 'shidou-and-nue', name: 'Shidou and Nue', type: 'Samurai + lightning Nushi', chapter: '11 – Mount Hiei', level: '–' },
  { slug: 'erymanth', name: 'Erymanth', type: 'Boar', chapter: '12 – The Capital', level: '47' },
  { slug: 'kunai-and-kirin', name: 'Kunai and Kirin', type: 'Swordswoman + Kirin', chapter: '12 – The Capital', level: '49' },
  { slug: 'final-boss', name: 'Final boss', type: '–', chapter: '13 – Center of the Blight', level: '–' },
] as const;

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: canonical,
    about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList', numberOfItems: nushi.length + otherBosses.length,
      itemListElement: [...nushi, ...otherBosses].map((b, index) => ({
        '@type': 'ListItem', position: index + 1, name: b.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Bosses', item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path} image={image} imageAlt="A large Nushi creature facing Emma in Beast of Reincarnation">
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400">
        <a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span>
        <span class="text-ash-300">Bosses</span>
      </nav>
      <div class="grid items-center gap-8 md:grid-cols-[1.1fr_.9fr]">
        <div>
          <SourceBadge source="official" />
          <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">
            Beast of Reincarnation Bosses: The Steam-Confirmed Roster
          </h1>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">
            Every boss name below comes from official Steam achievement data for App 2001760, with the
            global unlock rate recorded on 8 September 2026. The six Nushi regional bosses form a clear
            progression ladder; three paired or co-op combat entries sit alongside them. Each boss then
            has its own section with chapter, level, weakness and a step-by-step approach.
          </p>
        </div>
        <img src={image} alt="A large Nushi creature facing Emma in Beast of Reincarnation" width="1600" height="900" loading="eager" fetchpriority="high" class="rounded-xl border border-ash-800" />
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-4 py-12">
    <WikiSectionNav active={path} />

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold text-ash-50">The six Nushi regional bosses</h2>
      <p class="mt-2 max-w-3xl leading-relaxed text-ash-400">
        Nushi are the major regional boss encounters. The unlock-rate ladder is the only population data
        Valve publishes: it shows how many players beat each Nushi, not its health or difficulty.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-ash-800">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead class="bg-ash-900 text-ash-200">
            <tr><th class="px-4 py-3">Boss</th><th class="px-4 py-3">Achievement</th><th class="px-4 py-3">Global unlock</th><th class="px-4 py-3">What is verified</th></tr>
          </thead>
          <tbody>
            {nushi.map((b) => (
              <tr class="border-t border-ash-800">
                <th scope="row" class="px-4 py-3 font-medium text-ash-100">
                  {b.guide ? <a href={b.guide} class="text-ember-400 hover:underline">{b.name}</a> : b.name}
                </th>
                <td class="px-4 py-3 text-ash-300">{b.achievement}</td>
                <td class="px-4 py-3 tabular-nums text-ash-300">{b.rate}</td>
                <td class="px-4 py-3 text-ash-400">{b.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ash-50">Other combat achievements naming encounters</h2>
      <div class="mt-5 overflow-x-auto rounded-xl border border-ash-800">
        <table class="w-full min-w-[680px] text-left text-sm">
          <thead class="bg-ash-900 text-ash-200">
            <tr><th class="px-4 py-3">Entry</th><th class="px-4 py-3">Achievement</th><th class="px-4 py-3">Global unlock</th><th class="px-4 py-3">Boundary</th></tr>
          </thead>
          <tbody>
            {otherBosses.map((b) => (
              <tr class="border-t border-ash-800">
                <th scope="row" class="px-4 py-3 font-medium text-ash-100">{'guide' in b && b.guide ? <a href={b.guide} class="text-ember-400 hover:underline">{b.name}</a> : b.name}</th>
                <td class="px-4 py-3 text-ash-300">{b.achievement}</td>
                <td class="px-4 py-3 tabular-nums text-ash-300">{b.rate}</td>
                <td class="px-4 py-3 text-ash-400">{b.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section id="boss-order" class="mt-12 scroll-mt-24">
      <h2 class="font-display text-2xl font-bold text-ash-50">Boss order: every Nushi from Rangifer to the end</h2>
      <p class="mt-2 max-w-3xl leading-relaxed text-ash-400">
        Nushi are the regional guardian bosses – blighted animals fused with plants and machines. This is the
        order you meet them in the story. Koo's own Nushi form is also a mandatory late-game story encounter.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-ash-800">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="bg-ash-900 text-ash-200">
            <tr><th class="px-4 py-3">#</th><th class="px-4 py-3">Boss</th><th class="px-4 py-3">Animal / type</th><th class="px-4 py-3">Chapter</th><th class="px-4 py-3">Level</th></tr>
          </thead>
          <tbody>
            {order.map((b, i) => (
              <tr class="border-t border-ash-800">
                <td class="px-4 py-3 tabular-nums text-ash-400">{i + 1}</td>
                <th scope="row" class="px-4 py-3 font-medium text-ash-100"><a href={`#${b.slug}`} class="text-ember-400 hover:underline">{b.name}</a></th>
                <td class="px-4 py-3 text-ash-300">{b.type}</td>
                <td class="px-4 py-3 text-ash-300">{b.chapter}</td>
                <td class="px-4 py-3 tabular-nums text-ash-300">{b.level}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-6">
          <h3 class="font-display text-xl font-bold text-ash-50">Reading the Steam ladder</h3>
          <p class="mt-3 leading-relaxed text-ash-300">The biggest drop-off is Rangifer to Lacerta (53.5% to 43.8%): about one in five players who beat the first Nushi stop before the second. After Corvus the rates flatten around 25%, which is where most players who reach the late game finish it.</p>
          <p class="mt-3 leading-relaxed text-ash-300">With Hasten to the Capital (v1.1.01) you can skip Chapters 4–6, and therefore Taurus, on a New Game run – but Taurus's End then requires the Mountain Route on NG+.</p>
        </div>
        <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-6">
          <h3 class="font-display text-xl font-bold text-ash-50">What beating a Nushi gives you</h3>
          <ul class="mt-3 space-y-2 leading-relaxed text-ash-300">
            <li><strong class="text-ash-100">Nushi skills for Koo</strong> – Rangifer's restraint, Taurus's Charging Botan, Lacerta's Dokuzeri Shower.</li>
            <li><strong class="text-ash-100">Bloom Arts and Blade Arts</strong> – Dokuzeri: Fang, Kiku: Bloom Strike II and Finisher (Erymanth), Erica: Strangle and Blade Art: Nue (Shidou and Nue), Blade Art: Thunder (Kunai and Kirin).</li>
            <li><strong class="text-ash-100">Blades</strong> – Black Blossom (Shidou and Nue), Camellia (after Kunai and Kirin), First Moon (via the box from the first Corvus).</li>
          </ul>
        </div>
      </div>
      <div class="mt-6 rounded-xl border border-ash-800 bg-ash-900/40 p-6">
        <h3 class="font-display text-xl font-bold text-ash-50">Fighting any Nushi</h3>
        <ol class="mt-3 space-y-2 leading-relaxed text-ash-300">
          <li>1. Activate the nearest campsite first – dying costs no materials or experience, but resting respawns minor enemies.</li>
          <li>2. Bring the element from the <a href="/guides/beast-of-reincarnation-boss-weakness-chart/" class="text-ember-400 hover:underline">weakness chart</a>.</li>
          <li>3. Parry to build Flow; spend it when the boss is downed.</li>
          <li>4. Expect a second health bar in rematches and a red-glow aggression phase near half health. Patch v1.1.0 overhauled attack patterns for some Nushi variants, so pre-October videos may show older timings.</li>
        </ol>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ash-50">Boss-by-boss reference</h2>
      <p class="mt-2 max-w-3xl leading-relaxed text-ash-400">
        Encounter levels, weaknesses and move notes below are compiled from released-game player
        walkthroughs and were checked against patch v1.1.01 on 15 October 2026; achievement unlock
        rates are from Steam (App {GAME_FACTS.steamAppId}). Exact health values, frame data and full
        drop tables are not published by any source we use, so they are not listed.
      </p>
      <div class="mt-6 space-y-6">
        {BOSS_DETAILS.map((boss) => (
          <DetailEntry
            id={boss.slug}
            title={boss.name}
            intro={boss.intro}
            facts={boss.facts}
            steps={boss.steps}
            stepsTitle={`How to approach ${boss.name}`}
            links={BOSS_LINKS[boss.slug]}
          />
        ))}
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ash-50">Longer boss guides</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        <a href="/guides/nushi-boss-fight/" class="rounded-xl border border-ash-800 bg-ash-900/40 p-5 transition hover:border-ember-500"><h3 class="font-display text-lg font-bold text-ash-50">Rangifer fight guide</h3><p class="mt-2 text-sm leading-relaxed text-ash-400">Both encounters: fire weakness, hair-bridge opener, parry window, red-glow escape.</p></a>
        <a href="/guides/wasteland-colossal-boss/" class="rounded-xl border border-ash-800 bg-ash-900/40 p-5 transition hover:border-ember-500"><h3 class="font-display text-lg font-bold text-ash-50">Wasteland Colossal</h3><p class="mt-2 text-sm leading-relaxed text-ash-400">The large-creature search phrase mapped to the verified Rangifer record.</p></a>
        <a href="/guides/boss-achievements-guide/" class="rounded-xl border border-ash-800 bg-ash-900/40 p-5 transition hover:border-ember-500"><h3 class="font-display text-lg font-bold text-ash-50">Boss achievement roadmap</h3><p class="mt-2 text-sm leading-relaxed text-ash-400">The spoiler-light checklist built from Steam achievement names.</p></a>
        <a href="/guides/beast-of-reincarnation-boss-weakness-chart/" class="rounded-xl border border-ash-800 bg-ash-900/40 p-5 transition hover:border-ember-500"><h3 class="font-display text-lg font-bold text-ash-50">Boss weakness chart</h3><p class="mt-2 text-sm leading-relaxed text-ash-400">Elemental weaknesses for the named Nushi, kept separate from unpublished HP and drop tables.</p></a>
      </div>
    </section>

  </main>
</BaseLayout>
