---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JsonLd from '../../../components/JsonLd.astro';
import GuideCard from '../../../components/GuideCard.astro';
import { SITE, CATEGORIES, GAME_FACTS, type Category } from '../../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const cats = Object.keys(CATEGORIES) as Category[];

  return cats
    .map((cat) => {
      const items = guides
        .filter((g) => g.data.category === cat)
        .sort((a, b) => {
          if (a.data.order !== b.data.order) return a.data.order - b.data.order;
          return b.data.publishDate.getTime() - a.data.publishDate.getTime();
        });
      return { params: { category: cat }, props: { cat, items } };
    })
    .filter((p) => p.props.items.length > 0);
}

const { cat, items } = Astro.props;
const meta = CATEGORIES[cat];

const allPreview = items.every((g) => g.data.preview);

const path = `/guides/category/${cat}/`;
const title = `${meta.label} Pre-Release Outlines`;
const description = `${meta.blurb} Provisional ${meta.label.toLowerCase()} notes for Beast of Reincarnation ahead of the ${GAME_FACTS.releaseDate} launch.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: new URL(path, SITE.url).href,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: items.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: new URL(`/guides/${g.id}/`, SITE.url).href,
        name: g.data.heading ?? g.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Guides',
        item: new URL('/guides/', SITE.url).href,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: meta.label,
        item: new URL(path, SITE.url).href,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path}>
  <JsonLd slot="head" schema={schema} />

  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ash-400">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-ember-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/guides/" class="hover:text-ember-400">Guides</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ash-300">{meta.label}</li>
        </ol>
      </nav>
      <h1 class="font-display text-3xl font-bold text-ash-50 md:text-4xl">
        {meta.label}
      </h1>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ash-300">
        {meta.blurb}
      </p>
      {
        allPreview && (
          <p class="mt-4 max-w-2xl rounded-lg border border-ember-700/50 bg-ember-950/30 px-4 py-3 text-sm text-ember-100">
            All pages in this category are pre-release speculation. Prefer the
            <a href="/game-info/" class="underline hover:text-white">confirmed game info</a> until launch,
            then use these outlines as rewrite checklists.
          </p>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((guide) => (
          <GuideCard
            href={`/guides/${guide.id}/`}
            title={guide.data.heading ?? guide.data.title}
            description={guide.data.description}
            image={`/images/${guide.data.image}`}
            imageAlt={guide.data.imageAlt}
            category={guide.data.category}
            source={guide.data.source}
            date={guide.data.updateDate ?? guide.data.publishDate}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
