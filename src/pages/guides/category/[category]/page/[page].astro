---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import JsonLd from '../../../../../components/JsonLd.astro';
import GuideCard from '../../../../../components/GuideCard.astro';
import Pagination from '../../../../../components/Pagination.astro';
import { SITE, CATEGORIES, GAME_FACTS, type Category } from '../../../../../data/site';
import {
  GUIDE_PAGE_SIZE,
  pageCount,
  pageItems,
  sortGuides,
  type GuideEntry,
} from '../../../../../lib/guides';

interface Props {
  cat: Category;
  items: GuideEntry[];
  currentPage: number;
  totalPages: number;
}

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const cats = Object.keys(CATEGORIES) as Category[];
  const paths = [];

  for (const cat of cats) {
    const items = sortGuides(guides.filter((guide) => guide.data.category === cat));
    const totalPages = pageCount(items.length, GUIDE_PAGE_SIZE);

    for (let currentPage = 2; currentPage <= totalPages; currentPage += 1) {
      paths.push({
        params: { category: cat, page: String(currentPage) },
        props: {
          cat,
          items,
          currentPage,
          totalPages,
        },
      });
    }
  }

  return paths;
}

const { cat, items, currentPage, totalPages } = Astro.props;
const meta = CATEGORIES[cat];
const visibleItems = pageItems(items, currentPage, GUIDE_PAGE_SIZE);
const categoryPath = `/guides/category/${cat}/`;
const path = `${categoryPath}page/${currentPage}/`;
const title = `Beast of Reincarnation ${meta.label} — Page ${currentPage}`;
const description = `Page ${currentPage} of the Beast of Reincarnation ${meta.label.toLowerCase()} index, sorted by the latest published or materially updated guides.`;
const pageHref = (page: number) =>
  page === 1 ? categoryPath : `${categoryPath}page/${page}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: new URL(path, SITE.url).href,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: visibleItems.length,
      itemListElement: visibleItems.map((guide, index) => ({
        '@type': 'ListItem',
        position: (currentPage - 1) * GUIDE_PAGE_SIZE + index + 1,
        url: new URL(`/guides/${guide.id}/`, SITE.url).href,
        name: guide.data.heading ?? guide.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: meta.label, item: new URL(categoryPath, SITE.url).href },
      { '@type': 'ListItem', position: 4, name: `Page ${currentPage}`, item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path}>
  <JsonLd slot="head" schema={schema} />
  {currentPage > 1 && <link slot="head" rel="prev" href={new URL(pageHref(currentPage - 1), SITE.url).href} />}
  {currentPage < totalPages && <link slot="head" rel="next" href={new URL(pageHref(currentPage + 1), SITE.url).href} />}

  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ash-400">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-ember-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/guides/" class="hover:text-ember-400">Guides</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={categoryPath} class="hover:text-ember-400">{meta.label}</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ash-300">Page {currentPage}</li>
        </ol>
      </nav>
      <h1 class="font-display text-3xl font-bold text-ash-50 md:text-4xl">
        {meta.label} — Page {currentPage}
      </h1>
      <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ash-300">
        {meta.blurb} Browse this category by page, with the newest published or materially updated
        guides first. Sources and review dates remain visible on every card.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {visibleItems.map((guide) => (
        <GuideCard
          href={`/guides/${guide.id}/`}
          title={guide.data.heading ?? guide.data.title}
          description={guide.data.description}
          image={`/images/${guide.data.image}`}
          imageAlt={guide.data.imageAlt}
          category={guide.data.category}
          source={guide.data.source}
          date={guide.data.updateDate ?? guide.data.publishDate}
        />
      ))}
    </div>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath={categoryPath} />
  </section>
</BaseLayout>
