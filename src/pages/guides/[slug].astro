---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import GuideCard from '../../components/GuideCard.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import { SITE, CATEGORIES, GAME_FACTS } from '../../data/site';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);

const path = `/guides/${entry.id}/`;
const image = `/images/${data.image}`;
const cat = CATEGORIES[data.category];

const all = await getCollection('guides');
const related = all
  .filter((g) => g.id !== entry.id && g.data.category === data.category)
  .slice(0, 3);

const toc = headings.filter((h) => h.depth === 2);

const publishDate = data.publishDate;
const updateDate = data.updateDate ?? data.publishDate;
const isPreview = data.preview;

// Preview content: use WebPage + reviewed date language instead of claiming a verified Article publish.
const schema = isPreview
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: data.heading ?? data.title,
        description: data.description,
        url: new URL(path, SITE.url).href,
        dateModified: updateDate.toISOString(),
        about: {
          '@type': 'VideoGame',
          name: GAME_FACTS.name,
          url: GAME_FACTS.source,
        },
        isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
        creativeWorkStatus: 'Incomplete',
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Guides',
            item: new URL('/guides/', SITE.url).href,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: data.heading ?? data.title,
            item: new URL(path, SITE.url).href,
          },
        ],
      },
    ]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: data.heading ?? data.title,
        description: data.description,
        image: new URL(image, SITE.url).href,
        datePublished: publishDate.toISOString(),
        dateModified: updateDate.toISOString(),
        author: { '@type': 'Organization', name: SITE.name },
        publisher: {
          '@type': 'Organization',
          name: SITE.name,
          url: SITE.url,
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': new URL(path, SITE.url).href,
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Guides',
            item: new URL('/guides/', SITE.url).href,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: data.heading ?? data.title,
            item: new URL(path, SITE.url).href,
          },
        ],
      },
    ];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={data.title}
  description={data.description}
  path={path}
  image={image}
  imageAlt={data.imageAlt}
  ogType={isPreview ? 'website' : 'article'}
  publishDate={isPreview ? undefined : publishDate}
  updateDate={updateDate}
>
  <JsonLd slot="head" schema={schema} />

  <article>
    <div class="relative">
      <img
        src={image}
        alt={data.imageAlt}
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-[38vh] min-h-[260px] w-full object-cover md:h-[46vh]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ash-950 via-ash-950/60 to-ash-950/10"></div>
    </div>

    <div class="mx-auto -mt-24 max-w-3xl px-4 pb-16">
      <nav aria-label="Breadcrumb" class="relative mb-4 text-xs text-ash-400">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-ember-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/guides/" class="hover:text-ember-400">Guides</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ash-300">{cat.label}</li>
        </ol>
      </nav>

      <div class="relative flex flex-wrap items-center gap-2">
        <span class="inline-flex rounded-full bg-ember-600/90 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-ash-950">
          {cat.label}
        </span>
        <SourceBadge source={data.source} />
      </div>

      <h1 class="relative mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
        {data.heading ?? data.title}
      </h1>

      <p class="relative mt-4 text-lg leading-relaxed text-ash-300">
        {data.description}
      </p>

      {
        isPreview && (
          <aside
            role="note"
            class="relative mt-6 flex gap-3 rounded-lg border border-ember-700/60 bg-ember-950/40 p-4 text-sm leading-relaxed text-ember-100"
          >
            <span aria-hidden="true" class="mt-0.5 text-lg">⚠️</span>
            <p>
              <strong class="font-semibold text-ember-300">Pre-release preview.</strong>{' '}
              Beast of Reincarnation is scheduled for {GAME_FACTS.releaseDate} on Steam. This page is a
              planning outline based on official materials and expectations, not hands-on play. Names,
              routes, and tactics may change - we will verify everything after launch.
            </p>
          </aside>
        )
      }

      <div class="relative mt-4 flex flex-wrap items-center gap-3 text-xs text-ash-500">
        {
          isPreview ? (
            <time datetime={updateDate.toISOString()}>Last reviewed {fmt(updateDate)}</time>
          ) : (
            <>
              <time datetime={publishDate.toISOString()}>Published {fmt(publishDate)}</time>
              {data.updateDate && (
                <>
                  <span aria-hidden="true">•</span>
                  <time datetime={updateDate.toISOString()}>Updated {fmt(updateDate)}</time>
                </>
              )}
            </>
          )
        }
        <span aria-hidden="true">•</span>
        <a href="/game-info/" class="text-ember-400 hover:text-ember-500">Confirmed game info</a>
      </div>

      {
        toc.length > 1 && (
          <nav
            aria-label="Table of contents"
            class="relative mt-8 rounded-lg border border-ash-800 bg-ash-900/50 p-5"
          >
            <p class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-ash-300">
              On this page
            </p>
            <ol class="space-y-1.5 text-sm">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-ash-400 transition-colors hover:text-ember-400">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose relative mt-10 max-w-none">
        <Content />
      </div>

      <div class="relative mt-10 rounded-xl border border-ash-800 bg-ash-900/40 p-5 text-sm text-ash-300">
        <p class="font-display text-base font-semibold text-ash-50">Need confirmed facts instead?</p>
        <p class="mt-2">
          For release date, combat pillars, pricing, and PC specs, start with the
          <a href="/game-info/" class="text-ember-400 hover:text-ember-500">official game info page</a>.
          Editorial rules are on the <a href="/disclaimer/" class="text-ember-400 hover:text-ember-500">disclaimer</a>.
        </p>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t border-ash-800 bg-ash-900/30 py-14">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="mb-6 font-display text-2xl font-bold text-ash-50">
            Related {cat.label}
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((g) => (
              <GuideCard
                href={`/guides/${g.id}/`}
                title={g.data.heading ?? g.data.title}
                description={g.data.description}
                image={`/images/${g.data.image}`}
                imageAlt={g.data.imageAlt}
                category={g.data.category}
                source={g.data.source}
                date={g.data.updateDate ?? g.data.publishDate}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
