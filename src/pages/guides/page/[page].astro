---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JsonLd from '../../../components/JsonLd.astro';
import GuideCard from '../../../components/GuideCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { SITE, GAME_FACTS } from '../../../data/site';
import {
  GUIDE_PAGE_SIZE,
  pageCount,
  pageItems,
  sortGuides,
  type GuideEntry,
} from '../../../lib/guides';

interface Props {
  items: GuideEntry[];
  currentPage: number;
  totalPages: number;
}

export async function getStaticPaths() {
  const latest = sortGuides(await getCollection('guides'));
  const totalPages = pageCount(latest.length, GUIDE_PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        items: pageItems(latest, currentPage, GUIDE_PAGE_SIZE),
        currentPage,
        totalPages,
      },
    };
  });
}

const { items, currentPage, totalPages } = Astro.props;
const path = `/guides/page/${currentPage}/`;
const title = `Beast of Reincarnation Guides — Page ${currentPage}`;
const description = `Page ${currentPage} of the Beast of Reincarnation guide index, sorted by the latest published or materially updated guides.`;
const pageHref = (page: number) => (page === 1 ? '/guides/' : `/guides/page/${page}/`);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: new URL(path, SITE.url).href,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: items.length,
      itemListElement: items.map((guide, index) => ({
        '@type': 'ListItem',
        position: (currentPage - 1) * GUIDE_PAGE_SIZE + index + 1,
        url: new URL(`/guides/${guide.id}/`, SITE.url).href,
        name: guide.data.heading ?? guide.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: `Page ${currentPage}`, item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path}>
  <JsonLd slot="head" schema={schema} />
  {currentPage > 1 && <link slot="head" rel="prev" href={new URL(pageHref(currentPage - 1), SITE.url).href} />}
  {currentPage < totalPages && <link slot="head" rel="next" href={new URL(pageHref(currentPage + 1), SITE.url).href} />}

  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ash-400">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:text-ember-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/guides/" class="hover:text-ember-400">Guides</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ash-300">Page {currentPage}</li>
        </ol>
      </nav>
      <h1 class="font-display text-3xl font-bold text-ash-50 md:text-4xl">
        Beast of Reincarnation Guides — Page {currentPage}
      </h1>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-ash-300">
        More Beast of Reincarnation guides, with the newest published or materially updated pages
        first. The game released on {GAME_FACTS.releaseDateShort}; each guide keeps its source and
        review date visible.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-6 max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ash-50">Guide index — page {currentPage}</h2>
      <p class="mt-1 text-ash-400">Page {currentPage} of {totalPages}, with up to nine guides per page.</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((guide) => (
        <GuideCard
          href={`/guides/${guide.id}/`}
          title={guide.data.heading ?? guide.data.title}
          description={guide.data.description}
          image={`/images/${guide.data.image}`}
          imageAlt={guide.data.imageAlt}
          category={guide.data.category}
          source={guide.data.source}
          date={guide.data.updateDate ?? guide.data.publishDate}
        />
      ))}
    </div>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/guides/" />
  </section>
</BaseLayout>
