---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import GuideCard from '../../components/GuideCard.astro';
import Pagination from '../../components/Pagination.astro';
import WikiSectionCard from '../../components/WikiSectionCard.astro';
import WikiSectionNav from '../../components/WikiSectionNav.astro';
import { SITE, CATEGORIES, GAME_FACTS, WIKI_SECTIONS, type Category } from '../../data/site';
import { GUIDE_PAGE_SIZE, pageCount, pageItems, sortGuides } from '../../lib/guides';

const guides = await getCollection('guides');

const latest = sortGuides(guides);
const currentPage = 1;
const totalPages = pageCount(latest.length, GUIDE_PAGE_SIZE);
const visibleLatest = pageItems(latest, currentPage, GUIDE_PAGE_SIZE);

const order: Category[] = ['beginner', 'boss', 'enemies', 'combat', 'exploration'];
const groups = order
  .map((cat) => ({
    cat,
    meta: CATEGORIES[cat],
    items: latest.filter((g) => g.data.category === cat),
  }))
  .filter((g) => g.items.length > 0);

// 每个分类的关键词化 H2 + 诚实概述段落（元层面：说明这一类覆盖什么、
// 为什么重要、哪些还没按实机重写——不编造具体打法/数值）。
const SECTION: Record<Category, { h2: string; overview: string }> = {
  beginner: {
    h2: 'Beast of Reincarnation Beginner Guides',
    overview:
      'New to Beast of Reincarnation? Start here. These beginner guides cover the systems the shipped game actually runs on: the parry that feeds both florescence points and the entanglement gauge, Koo\'s bloom arts and their quicktime events, the Story/Normal/Hard difficulty range, and the Cleanse Walker upgrades that gate your weapons. They also cover the practical first-hours decisions — which dodge upgrade to take, why to find a campsite before a boss arena, and which materials force you to sweep a region before you can improve your gear.',
  },
  boss: {
    h2: 'Beast of Reincarnation Boss Guides',
    overview:
      'Boss fights are the backbone of any Beast of Reincarnation guide, and the game splits them into regional Nushi and other major encounters. The Rangifer page uses post-launch coverage of the real fight — both encounters, the level ranges, the fire weakness, the hair-bridge assassination opener and the red-glow antler combo that can kill Emma from full health. Other pages keep their encounter names and evidence boundaries explicit.',
  },
  enemies: {
    h2: 'Enemies & Wasteland Fauna',
    overview:
      'The wasteland of Year 4026 is filled with mutated fauna, and knowing what you are fighting is half the battle. The shipped game shows an enemy\'s elemental weakness next to its health bar and stamps "weak" over any matching bloom art, so the four elemental effects — poison, acid, flame and lightning — plus destructive and bind damage are the vocabulary this section works in. Named bestiary details are kept separate from visual descriptions and unsupported drop claims.',
  },
  combat: {
    h2: 'Combat Guides & Systems',
    overview:
      'Combat in Beast of Reincarnation is a hybrid system, blending Emma\'s direct attacks with Koo\'s commanded techniques in a single loop, and it has a clear centre of gravity: parrying. A parry negates the incoming hit, grants florescence points for Koo, grants entanglement points for Emma, and triggers her weapon effect. From there it branches into blade arts, Nushi skills, stagger and daze, elemental matching, and entanglement overdrive — which slows time and nothing else. These pages document the inputs and the trade-offs, with sources cited.',
  },
  exploration: {
    h2: 'Exploration & World Guides',
    overview:
      'Exploration guides cover the regions, traversal and progression materials of the Beast of Reincarnation world. Emma\'s blight-stricken braid is the key: Lift to rise like an extended double jump, Extend to bridge gaps — both navigation tools and combat openers, since a hair bridge over an enemy sets up an air assassination. Exploration is also mandatory progression, because levelling the Cleanse Walker needs Generator Devices, Electronic Brains and Memory Chips scattered across each region. Full maps and collectible lists are not something we claim to have verified.',
  },
};

const path = '/guides/';
// 含完整品牌名 → BaseLayout 不再追加 " | ...Wiki" 后缀，总长可控在 60 字符内。
const title = 'Beast of Reincarnation Wiki — Guides, Weapons & Walkthrough';
const description =
  'Beast of Reincarnation guides and wiki sections for weapons, chapters, skills, characters, bosses, combat and exploration, with sources cited on every page.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: new URL(path, SITE.url).href,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: visibleLatest.length,
    itemListElement: visibleLatest.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/guides/${guide.id}/`, SITE.url).href,
      name: guide.data.heading ?? guide.data.title,
    })),
  },
};
---

<BaseLayout title={title} description={description} path={path}>
  <JsonLd slot="head" schema={schema} />
  {totalPages > 1 && <link slot="head" rel="next" href={new URL('/guides/page/2/', SITE.url).href} />}

  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ash-400">
        <ol class="flex items-center gap-1.5">
          <li><a href="/" class="hover:text-ember-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ash-300">Guides</li>
        </ol>
      </nav>
      <h1 class="font-display text-3xl font-bold text-ash-50 md:text-4xl">
        Beast of Reincarnation Guides — Weapons, Walkthrough, Skills &amp; More
      </h1>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-ash-300">
        This is the hub for every Beast of Reincarnation guide, covering weapons, the 13-chapter
        walkthrough, skills, characters, bosses, combat, enemies, exploration, and beginner
        systems. The game released on
        {GAME_FACTS.releaseDateShort}. Pages carrying a
        <strong class="text-ash-100">Hands-on</strong> badge are written from the shipped build with
        their sources cited, while Official and Player reports keep their own evidence boundary.
        For facts confirmed on the store page, see the
        <a href="/game-info/" class="text-ember-400 hover:text-ember-500">game info page</a>.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {
          groups.map((g) => (
            <li>
              <a
                href={`#${g.cat}`}
                class="rounded-full border border-ash-700 px-3 py-1.5 text-sm text-ash-300 transition-colors hover:border-ember-500 hover:text-ember-400"
              >
                {g.meta.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-14">
    <WikiSectionNav />
    <div class="mt-8 mb-6 max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ash-50">
        Browse Beast of Reincarnation Wiki Sections
      </h2>
      <p class="mt-2 leading-relaxed text-ash-400">
        Use these focused indexes to find the answer behind a specific search: a weapon name,
        chapter title, skill-tree choice, or Emma and Koo build question. The indexes separate
        confirmed facts from hands-on coverage and future original play notes.
      </p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        WIKI_SECTIONS.map((section) => (
          <WikiSectionCard
            href={section.href}
            label={section.label}
            title={section.title}
            description={section.description}
          />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="mb-6 max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ash-50">Latest Beast of Reincarnation Guides</h2>
      <p class="mt-1 text-ash-400">
        Recently published or materially updated guides, newest first.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {visibleLatest.map((guide) => (
        <GuideCard
          href={`/guides/${guide.id}/`}
          title={guide.data.heading ?? guide.data.title}
          description={guide.data.description}
          image={`/images/${guide.data.image}`}
          imageAlt={guide.data.imageAlt}
          category={guide.data.category}
          source={guide.data.source}
          date={guide.data.updateDate ?? guide.data.publishDate}
        />
      ))}
    </div>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/guides/" />
  </section>

  {
    groups.map((g) => (
      <section id={g.cat} class="mx-auto max-w-6xl scroll-mt-24 px-4 py-14">
        <div class="mb-6 max-w-3xl">
          <h2 class="font-display text-2xl font-bold text-ash-50">{SECTION[g.cat].h2}</h2>
          <p class="mt-1 text-ash-400">{g.meta.blurb}</p>
          <p class="mt-4 leading-relaxed text-ash-300">{SECTION[g.cat].overview}</p>
        </div>
        <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-5">
          <p class="text-sm text-ash-400">
            {g.items.length} guides are available in this category, sorted newest first on the
            category page.
          </p>
          <a
            href={`/guides/category/${g.cat}/`}
            class="mt-4 inline-block text-sm font-medium text-ember-400 hover:text-ember-500"
          >
            Browse all {g.meta.label.toLowerCase()} guides →
          </a>
        </div>
      </section>
    ))
  }
</BaseLayout>
