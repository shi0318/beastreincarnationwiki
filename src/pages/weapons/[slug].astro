---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import WikiSectionNav from '../../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../../data/site';
import { WEAPON_DETAILS } from '../../data/section-pages';

export function getStaticPaths() {
  return WEAPON_DETAILS.map((weapon) => ({
    params: { slug: weapon.slug },
    props: { weapon },
  }));
}

const { weapon } = Astro.props;
const path = `/weapons/${weapon.slug}/`;
const canonical = new URL(path, SITE.url).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: weapon.title,
    description: weapon.description,
    url: canonical,
    image: new URL(weapon.image, SITE.url).href,
    about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Weapons', item: new URL('/weapons/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: weapon.title, item: canonical },
    ],
  },
];
---

<BaseLayout title={weapon.title} description={weapon.description} path={path} image={weapon.image} imageAlt={weapon.imageAlt} ogType="article" updateDate={new Date('2026-08-17T00:00:00Z')}>
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400"><a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span><a href="/weapons/" class="hover:text-ember-400">Weapons</a><span aria-hidden="true"> / </span><span class="text-ash-300">{weapon.title}</span></nav>
      <SourceBadge source="community" showBlurb />
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">{weapon.title}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">{weapon.intro}</p>
    </div>
  </section>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <WikiSectionNav active="/weapons/" />
    <section class="mt-10 grid gap-8 md:grid-cols-[1.1fr_.9fr]">
      <div>
        <h2 class="font-display text-2xl font-bold text-ash-50">Beast of Reincarnation {weapon.slug === 'blades' ? 'blade' : 'weapon'} facts</h2>
        <div class="mt-5 overflow-hidden rounded-xl border border-ash-800">
          <table class="w-full text-left text-sm"><tbody>{weapon.facts.map((fact) => <tr class="border-t border-ash-800 first:border-t-0"><th scope="row" class="w-2/5 bg-ash-900/60 px-4 py-3 font-medium text-ash-200">{fact.label}</th><td class="px-4 py-3 text-ash-300">{fact.value}</td></tr>)}</tbody></table>
        </div>
      </div>
      <img src={weapon.image} alt={weapon.imageAlt} width="1600" height="900" loading="eager" fetchpriority="high" class="rounded-xl border border-ash-800 object-cover" />
    </section>
    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ash-50">How to use this Beast of Reincarnation weapon note</h2>
      <ol class="mt-5 space-y-4 text-ash-300">{weapon.steps.map((step, index) => <li class="flex gap-3"><span class="font-display font-bold text-ember-400">{index + 1}.</span><span>{step}</span></li>)}</ol>
    </section>
    <section class="mt-12 rounded-xl border border-ash-800 bg-ash-900/40 p-6">
      <h2 class="font-display text-xl font-bold text-ash-50">Evidence boundary</h2>
      <p class="mt-3 leading-relaxed text-ash-300">{weapon.evidence}</p>
    </section>
    <section class="mt-12 border-t border-ash-800 pt-6 text-sm leading-relaxed text-ash-400">
      <h2 class="font-display text-xl font-bold text-ash-200">Sources</h2>
      <p class="mt-2">{weapon.sourceNote} <a class="text-ember-400 hover:text-ember-300" href="https://steamcommunity.com/sharedfiles/filedetails/?id=3777472649" rel="noopener" target="_blank">Open the Steam Community guide</a> or <a class="text-ember-400 hover:text-ember-300" href={GAME_FACTS.source} rel="noopener" target="_blank">check the official Steam listing</a>.</p>
    </section>
  </main>
</BaseLayout>
