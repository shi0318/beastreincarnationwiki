---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceBadge from '../components/SourceBadge.astro';
import WikiSectionNav from '../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../data/site';

const path = '/collectibles/';
const title = 'Beast of Reincarnation Collectibles: Valuables, Locked Treasures & Spirit Stones';
const description =
  'Beast of Reincarnation collectible hub: the Steam map filter system for valuables, locked treasures, seedlings and Spirit Stones, with per-category guides and Cleanse Walker materials.';
const image = '/images/beast-of-reincarnation-waterfall-grotto.webp';
const canonical = new URL(path, SITE.url).href;

// 类别名与例子全部来自 Steam 社区互动地图（id 3778455109）的过滤器与 FAQ，快照 2026-08-14。
const categories = [
  {
    name: 'Valuables',
    filter: 'Valuable',
    guide: '/collectibles/valuables/',
    facts: [
      'The Steam map FAQ names Facility Modules, Electronic Brains, Generator Devices, Fertilized Eggs and Walker decorations as valuable objects that matter to completion or the Cleanse Walker.',
      'The map author counts 21 valuables in the Ancient Civilization Zone alone — a dated community count, not an official requirement.',
    ],
  },
  {
    name: 'Locked Treasures',
    filter: 'Locked Treasure',
    guide: '/collectibles/locked-treasures/',
    facts: [
      'A separate map filter from ordinary Treasure Box containers.',
      'Markers behind gates pair with the Bulkhead and Control Panel filters; vertical or cave markers pair with Lift and Extend traversal.',
      'The official store page publishes no locked-treasure count or reward table, so this site records method, not invented contents.',
    ],
  },
  {
    name: 'Spirit Stones',
    filter: '—',
    guide: '/collectibles/spirit-stones/',
    facts: [
      'Build customization alongside skill trees, gear and weapon choices; three tested directions are parry/counter, ranged/control and stealth/exploration.',
      'Effect wording and costs are version-sensitive — save the patch number with every comparison.',
    ],
  },
  {
    name: 'Seedlings & Crops',
    filter: 'Seedling',
    guide: '/collectibles/seedlings/',
    facts: [
      'Their own map filters, feeding the Green Thumb achievement (26.7% global unlock).',
      'Keep seedling progress separate from treasure counts — they serve different completion goals.',
    ],
  },
  {
    name: 'Cleanse Walker Materials',
    filter: 'Generator Device / Electronic Brain / Memory Chip',
    guide: '/collectibles/cleanse-walker/',
    facts: [
      'Three named upgrade-material categories tracked on the Steam map.',
      'Use the dedicated upgrade route page rather than mixing them into the general valuable sweep.',
    ],
  },
  {
    name: 'Documents & Books',
    filter: 'Document / Book',
    guide: '/walkthrough/',
    facts: [
      'Lore and information pickups tracked per chapter on the walkthrough pages — e.g. the Steam chapter table reports 10 documents in Matsukawa Zone, the highest count.',
      'Several regions report zero documents; do not search for pickups the source table does not list.',
    ],
  },
] as const;

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: canonical,
    about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: {
      '@type': 'ItemList', numberOfItems: categories.length,
      itemListElement: categories.map((c, index) => ({
        '@type': 'ListItem', position: index + 1, name: c.name, url: new URL(c.guide, SITE.url).href,
      })),
    },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Collectibles', item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path} image={image} imageAlt="Emma standing on a rocky ledge above a waterfall grotto in Beast of Reincarnation">
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400">
        <a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span>
        <span class="text-ash-300">Collectibles</span>
      </nav>
      <div class="grid items-center gap-8 md:grid-cols-[1.1fr_.9fr]">
        <div>
          <SourceBadge source="community" showBlurb />
          <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">
            Beast of Reincarnation Collectibles: The Filter System
          </h1>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">
            The Steam Community interactive map separates collectibles into distinct filters — Valuable,
            Document, Book, Treasure Box, Locked Treasure, Seedling and the Cleanse Walker material types.
            This hub links one verified guide per category. The method that works: one filter at a time,
            recorded against region and landmark, never mixing a map pin with a picked-up item.
          </p>
        </div>
        <img src={image} alt="Emma standing on a rocky ledge above a waterfall grotto in Beast of Reincarnation" width="1600" height="900" loading="eager" fetchpriority="high" class="rounded-xl border border-ash-800" />
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-6xl px-4 py-12">
    <WikiSectionNav active={path} />

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold text-ash-50">Collectible categories</h2>
      <div class="mt-6 space-y-6">
        {categories.map((c) => (
          <article class="rounded-xl border border-ash-800 bg-ash-900/40 p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-xl font-bold text-ash-50">{c.name}</h3>
              <p class="text-xs uppercase tracking-[0.16em] text-ash-500">Map filter: {c.filter}</p>
            </div>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ash-300">
              {c.facts.map((f) => <li class="flex gap-2"><span aria-hidden="true" class="text-ember-400">•</span><span>{f}</span></li>)}
            </ul>
            <a href={c.guide} class="mt-3 inline-block text-sm font-medium text-ember-400 hover:underline">
              {c.name} guide →
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-xl border border-ash-800 bg-ash-900/40 p-6">
      <h2 class="font-display text-xl font-bold text-ash-50">Are collectibles missable?</h2>
      <p class="mt-3 leading-relaxed text-ash-300">
        The Steam Community achievement walkthrough says its current player route treats collectibles as
        recoverable and uses a second playthrough plus post-playthrough farming. That guide is explicitly
        work-in-progress, so this site does not convert the statement into an official no-missables
        guarantee. If a story transition changes access in your build, keep a backup save before leaving
        a region.
      </p>
    </section>
  </main>
</BaseLayout>
