---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found';
const description =
  'This page could not be found. Head back to the Beast of Reincarnation Wiki home page, game info, or guides.';
---

<BaseLayout title={title} description={description} path="/404/" noindex={true}>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
    <p class="font-display text-6xl font-bold text-ember-400 md:text-7xl">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-ash-50 md:text-3xl">
      This path leads nowhere
    </h1>
    <p class="mt-4 max-w-md leading-relaxed text-ash-300">
      The page you're looking for doesn't exist or may have moved. Try one of
      these instead:
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-lg bg-ember-500 px-5 py-2.5 font-semibold text-ash-950 transition-colors hover:bg-ember-400"
      >
        Home
      </a>
      <a
        href="/game-info/"
        class="rounded-lg border border-ash-700 px-5 py-2.5 font-semibold text-ash-200 transition-colors hover:border-ash-500 hover:text-ash-50"
      >
        Game Info
      </a>
      <a
        href="/guides/"
        class="rounded-lg border border-ash-700 px-5 py-2.5 font-semibold text-ash-200 transition-colors hover:border-ash-500 hover:text-ash-50"
      >
        Guides
      </a>
    </div>
  </section>
</BaseLayout>
