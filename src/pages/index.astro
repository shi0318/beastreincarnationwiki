---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import GuideCard from '../components/GuideCard.astro';
import { SITE, CATEGORIES, GAME_FACTS, type Category } from '../data/site';

const guides = await getCollection('guides');

// 排序：featured 优先，其次 order 升序，再按发布日期倒序
const sorted = [...guides].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const featured = sorted[0];
const rest = sorted.slice(1, 7);

// 按分类分组用于分区展示
const byCategory = (cat: Category) =>
  sorted.filter((g) => g.data.category === cat);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/guides/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
];
---

<BaseLayout title={SITE.name} description={SITE.description} path="/">
  <JsonLd slot="head" schema={schema} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-ash-800">
    {
      featured && (
        <img
          src={`/images/${featured.data.image}`}
          alt={featured.data.imageAlt}
          width="1600"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover opacity-40"
        />
      )
    }
    <div
      class="absolute inset-0 bg-gradient-to-t from-ash-950 via-ash-950/80 to-ash-950/40"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 py-24 md:py-32">
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-ember-400">
        Beast of Reincarnation
      </p>
      <p class="mt-3 inline-flex items-center gap-2 rounded-full border border-ember-700/60 bg-ember-950/40 px-3 py-1 text-sm text-ember-200">
        <span aria-hidden="true">📅</span>
        Releasing {GAME_FACTS.releaseDate} · {GAME_FACTS.developer}
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-tight text-ash-50 md:text-6xl">
        {SITE.tagline}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash-300">
        {SITE.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/game-info/"
          class="rounded-lg bg-ember-600 px-6 py-3 font-semibold text-ash-950 transition-colors hover:bg-ember-500"
        >
          Everything we know
        </a>
        <a
          href="/guides/"
          class="rounded-lg border border-ash-600 px-6 py-3 font-semibold text-ash-100 transition-colors hover:border-ash-400 hover:bg-ash-800"
        >
          Browse all guides
        </a>
      </div>
    </div>
  </section>

  <!-- Latest guides -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-8 flex items-end justify-between">
      <h2 class="font-display text-2xl font-bold text-ash-50 md:text-3xl">
        Latest guides
      </h2>
      <a href="/guides/" class="text-sm font-medium text-ember-400 hover:text-ember-500">
        View all →
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((g, i) => (
          <GuideCard
            href={`/guides/${g.id}/`}
            title={g.data.heading ?? g.data.title}
            description={g.data.description}
            image={`/images/${g.data.image}`}
            imageAlt={g.data.imageAlt}
            category={g.data.category}
            source={g.data.source}
            eager={i < 3}
          />
        ))
      }
    </div>
  </section>

  <!-- Category sections -->
  {
    (['boss', 'combat', 'exploration'] as Category[]).map((cat) => {
      const items = byCategory(cat).slice(0, 3);
      if (items.length === 0) return null;
      const meta = CATEGORIES[cat];
      return (
        <section class="border-t border-ash-800 py-14">
          <div class="mx-auto max-w-6xl px-4">
            <div class="mb-6">
              <h2 class="font-display text-2xl font-bold text-ash-50">
                {meta.label}
              </h2>
              <p class="mt-1 text-ash-400">{meta.blurb}</p>
            </div>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((g) => (
                <GuideCard
                  href={`/guides/${g.id}/`}
                  title={g.data.heading ?? g.data.title}
                  description={g.data.description}
                  image={`/images/${g.data.image}`}
                  imageAlt={g.data.imageAlt}
                  category={g.data.category}
                  source={g.data.source}
                />
              ))}
            </div>
          </div>
        </section>
      );
    })
  }
</BaseLayout>
