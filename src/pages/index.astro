---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import GuideCard from '../components/GuideCard.astro';
import SourceBadge from '../components/SourceBadge.astro';
import { SITE, GAME_FACTS } from '../data/site';

const guides = await getCollection('guides');

const homeTitle = `${SITE.name} - Release Date, Story & Guides`;

const sorted = [...guides].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.publishDate.getTime() - a.data.publishDate.getTime();
});

const previews = sorted.slice(0, 6);

const confirmedFacts = [
  { label: 'Release date', value: GAME_FACTS.releaseDate },
  { label: 'Developer', value: GAME_FACTS.developer },
  { label: 'Publisher', value: GAME_FACTS.publisher },
  { label: 'Platform', value: GAME_FACTS.platform },
  { label: 'Combat', value: 'Real-time + turn-based hybrid' },
  { label: 'Price (Steam)', value: `${GAME_FACTS.priceUsd} / Deluxe ${GAME_FACTS.deluxePriceUsd}` },
];

const pillars = [
  {
    title: 'One-person, one-dog combat',
    body: GAME_FACTS.combatSummary,
  },
  {
    title: 'Post-apocalyptic Japan, 4026',
    body: GAME_FACTS.storySummary,
  },
  {
    title: 'Build your loadout',
    body: GAME_FACTS.buildSummary,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: GAME_FACTS.name,
    description: GAME_FACTS.shortDescription,
    url: GAME_FACTS.source,
    genre: GAME_FACTS.genres,
    gamePlatform: ['PC', 'PlayStation 5', 'Xbox Series X|S'],
    datePublished: GAME_FACTS.releaseDateISO,
    author: { '@type': 'Organization', name: GAME_FACTS.developer },
    publisher: { '@type': 'Organization', name: GAME_FACTS.publisher },
    offers: {
      '@type': 'Offer',
      price: '59.99',
      priceCurrency: 'USD',
      availability: 'https://schema.org/PreOrder',
      url: GAME_FACTS.source,
    },
  },
];
---

<BaseLayout title={homeTitle} description={SITE.description} path="/">
  <JsonLd slot="head" schema={schema} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-ash-800">
    <img
      src="/images/beast-of-reincarnation-nushi-boss-fight.webp"
      alt="Emma and Koo in Beast of Reincarnation's post-apocalyptic wasteland"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-40"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ash-950 via-ash-950/80 to-ash-950/40"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-24 md:py-32">
      <img
        src="/images/beast-of-reincarnation-logo-banner.webp"
        alt="Beast of Reincarnation banner"
        width="460"
        height="215"
        loading="eager"
        decoding="async"
        class="mb-6 h-auto w-full max-w-xl rounded-lg border border-ash-700/60 shadow-lg"
      />
      <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-ember-400">
        Beast of Reincarnation
      </p>
      <p class="mt-3 inline-flex flex-wrap items-center gap-2 rounded-full border border-ember-700/60 bg-ember-950/40 px-3 py-1 text-sm text-ember-200">
        <span aria-hidden="true">📅</span>
        Release: {GAME_FACTS.releaseDate} · PC · PS5 · Xbox Series X|S · {GAME_FACTS.developer}
      </p>
      <h1 class="mt-4 max-w-3xl font-display text-4xl font-bold leading-tight text-ash-50 md:text-6xl">
        Beast of Reincarnation Wiki — Release Date, Story & Confirmed Game Info
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ash-300">
        {GAME_FACTS.shortDescription}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/game-info/"
          class="rounded-lg bg-ember-600 px-6 py-3 font-semibold text-ash-950 transition-colors hover:bg-ember-500"
        >
          Confirmed game info
        </a>
        <a
          href={GAME_FACTS.source}
          rel="noopener"
          target="_blank"
          class="rounded-lg border border-ash-600 px-6 py-3 font-semibold text-ash-100 transition-colors hover:border-ash-400 hover:bg-ash-800"
        >
          Official Steam page
        </a>
      </div>
      <p class="mt-4 text-xs text-ash-500">
        Source verified from the official Steam listing on {GAME_FACTS.lastVerified}. Pre-purchase is live; the game is not out yet.
      </p>
    </div>
  </section>

  <!-- Confirmed facts -->
  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="mb-6 flex flex-wrap items-center gap-3">
        <h2 class="font-display text-2xl font-bold text-ash-50 md:text-3xl">
          What is confirmed right now
        </h2>
        <SourceBadge source="official" />
      </div>
      <p class="max-w-3xl text-ash-300">
        Before launch, this site prioritizes official Steam facts over strategy speculation.
        Use this section for release planning; treat preview guides as provisional only.
      </p>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          confirmedFacts.map((f) => (
            <div class="rounded-xl border border-ash-800 bg-ash-950/40 p-5">
              <dt class="text-xs font-semibold uppercase tracking-wide text-ash-500">{f.label}</dt>
              <dd class="mt-2 font-display text-lg font-semibold leading-snug text-ash-50">{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-8">
        <a href="/game-info/" class="text-sm font-medium text-ember-400 hover:text-ember-500">
          Full confirmed overview, FAQ & PC specs →
        </a>
      </div>
    </div>
  </section>

  <!-- Official pillars -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-8 max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ash-50 md:text-3xl">
        Official pillars from Steam
      </h2>
      <p class="mt-3 text-ash-300">
        These are the systems and story beats Game Freak and Fictions already publish on Steam  - 
        not player-tested walkthrough claims.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {
        pillars.map((p) => (
          <article class="rounded-xl border border-ash-800 bg-ash-900/40 p-6">
            <h3 class="font-display text-xl font-semibold text-ash-50">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ash-300">{p.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- System snapshot -->
  <section class="border-y border-ash-800 bg-ash-900/20">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-bold text-ash-50">PC system requirements</h2>
          <p class="mt-3 text-ash-300">
            Steam currently lists Windows-only support, full controller support, 45 GB storage, and SSD required.
          </p>
          <ul class="mt-6 space-y-3 text-sm text-ash-300">
            <li><strong class="text-ash-100">Minimum GPU:</strong> GTX 1070 / RX 580 (8 GB)</li>
            <li><strong class="text-ash-100">Recommended GPU:</strong> RTX 3060 / RX 6700 XT (12 GB)</li>
            <li><strong class="text-ash-100">Memory:</strong> 16 GB RAM</li>
            <li><strong class="text-ash-100">Storage:</strong> 45 GB SSD</li>
          </ul>
          <a href="/game-info/#system-requirements" class="mt-6 inline-block text-sm font-medium text-ember-400 hover:text-ember-500">
            See full minimum & recommended specs →
          </a>
        </div>
        <div class="rounded-xl border border-ash-800 bg-ash-950/40 p-6">
          <h3 class="font-display text-lg font-semibold text-ash-50">Also confirmed on Steam</h3>
          <ul class="mt-4 grid gap-2 text-sm text-ash-300 sm:grid-cols-2">
            {GAME_FACTS.features.map((f) => (
              <li class="rounded-lg border border-ash-800 bg-ash-900/50 px-3 py-2">{f}</li>
            ))}
          </ul>
          <p class="mt-4 text-xs text-ash-500">
            Genres listed: {GAME_FACTS.genres.join(', ')}. Languages include full audio for English and Japanese.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Section deep-dives -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-8 max-w-3xl">
      <h2 class="font-display text-2xl font-bold text-ash-50 md:text-3xl">
        What each part of this wiki covers
      </h2>
      <p class="mt-3 text-ash-300">
        Everything below is drawn from the official Steam listing, verified on
        {GAME_FACTS.lastVerified}. Where we step beyond confirmed material, we say so.
      </p>
    </div>

    <div class="space-y-6">
      <article class="rounded-xl border border-ash-800 bg-ash-900/40 p-6 md:p-8">
        <h3 class="font-display text-xl font-semibold text-ash-50">
          Combat: how the hybrid system actually works
        </h3>
        <p class="mt-3 max-w-3xl text-ash-300">
          Beast of Reincarnation is built on a fusion of real-time action and turn-based RPG
          combat, which is the most unusual thing about it. You control
          <strong class="text-ash-50">Emma</strong> and her sword abilities directly in real time,
          while <strong class="text-ash-50">Koo</strong>, a blighted dog, acts on your commands to
          unleash techniques. The pitch is that you fight as a unit rather than as a character with
          a pet following behind.
        </p>
        <p class="mt-3 max-w-3xl text-ash-400">
          In practice that means two resource layers to think about: Emma's moment-to-moment
          positioning and attacks, and the timing of Koo's commanded techniques. Game Freak has not
          published frame data, stamina rules, or a full move list, so anyone posting combo routes
          or parry timings right now is guessing. Our
          <a href="/guides/category/combat/" class="text-ember-400 hover:text-ember-500">combat
          pages</a> separate the officially confirmed pillars from provisional technique notes, and
          the notes are labeled as speculation until we can test the shipped game on
          {GAME_FACTS.releaseDate}.
        </p>
      </article>

      <article class="rounded-xl border border-ash-800 bg-ash-900/40 p-6 md:p-8">
        <h3 class="font-display text-xl font-semibold text-ash-50">
          Story and world: Emma, Koo, and the year 4026
        </h3>
        <p class="mt-3 max-w-3xl text-ash-300">
          The game is set in a post-apocalyptic Japan in the year
          <strong class="text-ash-50">4026</strong>, described officially as a beautiful yet harsh
          world. Emma is an outcast, shunned for an affliction she carries; Koo is a blighted dog.
          Together they travel a blighted land, battle Bosses, capture their powers, and work
          toward defeating the <strong class="text-ash-50">Beast of Reincarnation</strong> itself.
        </p>
        <p class="mt-3 max-w-3xl text-ash-400">
          Capturing boss powers is the detail worth watching, because it implies progression is
          tied to encounters rather than only to a skill tree — beat a Boss, gain something that
          changes what you can do next. Chapter structure, the number of Bosses, and how much of
          the world is open are all unannounced. Story Rich and Single-player are official Steam
          tags, so expect an authored narrative rather than an emergent one. Our
          <a href="/game-info/" class="text-ember-400 hover:text-ember-500">confirmed game info
          page</a> holds the full official overview, FAQ, and PC requirements.
        </p>
      </article>

      <article class="rounded-xl border border-ash-800 bg-ash-900/40 p-6 md:p-8">
        <h3 class="font-display text-xl font-semibold text-ash-50">
          Builds: skill trees, gear, and spirit stones
        </h3>
        <p class="mt-3 max-w-3xl text-ash-300">
          Officially, you customize your playstyle through skill trees, gear, and
          <strong class="text-ash-50">spirit stones</strong>, with ranged, stealthy, and aggressive
          loadouts all called out by name. Three named archetypes in pre-launch marketing is a
          strong signal that build variety is a real pillar rather than a bullet point.
        </p>
        <p class="mt-3 max-w-3xl text-ash-400">
          What is not public: the actual skill tree layout, how spirit stones are acquired or
          slotted, whether respeccing is free, and how gear rarity works. Those are exactly the
          details a build guide needs, which is why we are not publishing tier lists yet. The site
          runs on a source-tracking system — every claim carries a confirmation status, and
          provisional pages are marked <code class="text-ash-200">noindex</code> so speculation
          never competes with verified facts in search. Pre-purchase is live on Steam at
          {GAME_FACTS.priceUsd}, with a Deluxe edition at {GAME_FACTS.deluxePriceUsd}, but the game
          is not out yet.
        </p>
      </article>
    </div>
  </section>

  <!-- Pre-release previews -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-ash-500">
          Secondary · Pre-release only
        </p>
        <h2 class="mt-2 font-display text-2xl font-bold text-ash-50 md:text-3xl">
          Provisional guide outlines
        </h2>
        <p class="mt-2 text-ash-400">
          These pages are labeled speculation, marked noindex, and written as planning notes until the
          {GAME_FACTS.releaseDate} launch. Prefer the confirmed info above.
        </p>
      </div>
      <a href="/guides/" class="text-sm font-medium text-ember-400 hover:text-ember-500">
        Browse all previews →
      </a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        previews.map((g, i) => (
          <GuideCard
            href={`/guides/${g.id}/`}
            title={g.data.heading ?? g.data.title}
            description={g.data.description}
            image={`/images/${g.data.image}`}
            imageAlt={g.data.imageAlt}
            category={g.data.category}
            source={g.data.source}
            date={g.data.updateDate ?? g.data.publishDate}
            eager={i < 3}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
