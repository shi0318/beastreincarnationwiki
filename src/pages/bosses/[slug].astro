---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import WikiSectionNav from '../../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../../data/site';
import { BOSS_DETAILS } from '../../data/section-pages';

export function getStaticPaths() {
  return BOSS_DETAILS.map((boss) => ({
    params: { slug: boss.slug },
    props: { boss },
  }));
}

const { boss } = Astro.props;
const path = `/bosses/${boss.slug}/`;
const canonical = new URL(path, SITE.url).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: boss.title,
    description: boss.description,
    url: canonical,
    image: new URL(boss.image, SITE.url).href,
    about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Bosses', item: new URL('/bosses/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: boss.name, item: canonical },
    ],
  },
];
---

<BaseLayout title={boss.title} description={boss.description} path={path} image={boss.image} imageAlt={boss.imageAlt} ogType="article" updateDate={new Date('2026-09-16T00:00:00Z')}>
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400">
        <a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span>
        <a href="/bosses/" class="hover:text-ember-400">Bosses</a><span aria-hidden="true"> / </span>
        <span class="text-ash-300">{boss.name}</span>
      </nav>
      <SourceBadge source="official" showBlurb />
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">{boss.title}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">{boss.intro}</p>
    </div>
  </section>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <WikiSectionNav active="/bosses/" />
    <section class="mt-10 grid gap-8 md:grid-cols-[1.1fr_.9fr]">
      <div>
        <h2 class="font-display text-2xl font-bold text-ash-50">{boss.name} facts</h2>
        <div class="mt-5 overflow-hidden rounded-xl border border-ash-800">
          <table class="w-full text-left text-sm">
            <tbody>
              {boss.facts.map((fact) => (
                <tr class="border-t border-ash-800 first:border-t-0">
                  <th scope="row" class="w-2/5 bg-ash-900/60 px-4 py-3 font-medium text-ash-200">{fact.label}</th>
                  <td class="px-4 py-3 text-ash-300">{fact.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <img src={boss.image} alt={boss.imageAlt} width="1600" height="900" loading="eager" fetchpriority="high" class="rounded-xl border border-ash-800 object-cover" />
    </section>
    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ash-50">How to use this page</h2>
      <ol class="mt-5 space-y-4 text-ash-300">
        {boss.steps.map((step, index) => (
          <li class="flex gap-3">
            <span class="font-display font-bold text-ember-400">{index + 1}.</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>
    <section class="mt-12 rounded-xl border border-ash-800 bg-ash-900/40 p-6">
      <h2 class="font-display text-xl font-bold text-ash-50">What is not published</h2>
      <p class="mt-3 leading-relaxed text-ash-300">{boss.evidence}</p>
    </section>
    <p class="mt-8 text-sm text-ash-400">
      <a href="/bosses/" class="text-ember-400 hover:underline">All bosses</a>
      {boss.slug === 'rangifer' && (
        <>
          {' · '}
          <a href="/guides/nushi-boss-fight/" class="text-ember-400 hover:underline">Full Rangifer fight guide</a>
        </>
      )}
      {boss.slug === 'lacerta' && (
        <>
          {' · '}
          <a href="/weapons/thunderwave-sword/" class="text-ember-400 hover:underline">Thunderwave Sword</a>
        </>
      )}
    </p>
  </main>
</BaseLayout>
