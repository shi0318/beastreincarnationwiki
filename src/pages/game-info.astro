---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceBadge from '../components/SourceBadge.astro';
import { SITE, GAME_FACTS, SOURCES, type SourceKey } from '../data/site';

const path = '/game-info/';
const title = 'Beast of Reincarnation - Release Date, Story, Specs & Everything Confirmed';
const description =
  'Confirmed Beast of Reincarnation info: Aug 4, 2026 release on PC, PS5 & Xbox Series X|S, Game Freak / Fictions, hybrid combat, PC system requirements, price, and FAQ.';

const facts = [
  { label: 'Release date', value: GAME_FACTS.releaseDate },
  { label: 'Developer', value: GAME_FACTS.developer },
  { label: 'Publisher', value: GAME_FACTS.publisher },
  { label: 'Platforms', value: GAME_FACTS.platform },
  { label: 'Genre', value: `${GAME_FACTS.genres.join(' / ')}` },
  { label: 'Price', value: `${GAME_FACTS.priceUsd} (Deluxe ${GAME_FACTS.deluxePriceUsd})` },
  { label: 'Controller', value: GAME_FACTS.controllerSupport },
  { label: 'Status', value: 'Coming soon · pre-purchase live' },
];

const faq = [
  {
    q: 'When does Beast of Reincarnation release?',
    a: `Beast of Reincarnation launches on ${GAME_FACTS.releaseDate} (00:00 UTC in all regions). Pre-purchase is already live on the official Steam store.`,
  },
  {
    q: 'Who is developing and publishing Beast of Reincarnation?',
    a: `It is developed by ${GAME_FACTS.developer} and published by ${GAME_FACTS.publisher}.`,
  },
  {
    q: 'What platforms is Beast of Reincarnation on?',
    a: `Beast of Reincarnation launches on ${GAME_FACTS.platform} — all three on ${GAME_FACTS.releaseDate}. On PC it is sold via Steam; the PS5 and Xbox Series X|S versions release the same day on their own stores.`,
  },
  {
    q: 'Is Beast of Reincarnation a Souls-like?',
    a: 'Not exactly. Official copy describes a hybrid combat system that fuses real-time action with turn-based RPG elements, built around Emma and Koo fighting as a unit.',
  },
  {
    q: 'How does the Emma and Koo combat system work?',
    a: GAME_FACTS.combatSummary,
  },
  {
    q: 'What are the PC system requirements?',
    a: `Minimum: ${GAME_FACTS.systemRequirements.minimum.cpu}, ${GAME_FACTS.systemRequirements.minimum.gpu}, 16 GB RAM, 45 GB SSD. Recommended: ${GAME_FACTS.systemRequirements.recommended.cpu}, ${GAME_FACTS.systemRequirements.recommended.gpu}, 16 GB RAM, 45 GB SSD.`,
  },
  {
    q: 'How much does Beast of Reincarnation cost on Steam?',
    a: `Steam currently lists the standard edition at ${GAME_FACTS.priceUsd} and the Deluxe Edition at ${GAME_FACTS.deluxePriceUsd} (USD, no discount at last check).`,
  },
  {
    q: 'Are the guides on this site confirmed?',
    a: 'Not yet. Strategy pages are pre-release previews built from official materials and expectations, not hands-on play. They are labeled speculation and kept noindex until verified after launch.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: GAME_FACTS.name,
    description,
    url: new URL(path, SITE.url).href,
    genre: GAME_FACTS.genres,
    gamePlatform: ['PC', 'PlayStation 5', 'Xbox Series X|S'],
    datePublished: GAME_FACTS.releaseDateISO,
    author: { '@type': 'Organization', name: GAME_FACTS.developer },
    publisher: { '@type': 'Organization', name: GAME_FACTS.publisher },
    offers: {
      '@type': 'Offer',
      price: '59.99',
      priceCurrency: 'USD',
      availability: 'https://schema.org/PreOrder',
      url: GAME_FACTS.source,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Game Info',
        item: new URL(path, SITE.url).href,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path}>
  <JsonLd slot="head" schema={schema} />

  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-4xl px-4 py-14">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ash-400">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-ember-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ash-300">Game Info</li>
        </ol>
      </nav>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
          Beast of Reincarnation: Everything Confirmed
        </h1>
        <SourceBadge source="official" />
      </div>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ash-300">
        A living summary of what {GAME_FACTS.developer} and {GAME_FACTS.publisher}
        have published on Steam - release date, combat pillars, story setup, pricing,
        features, and PC requirements. Last verified {GAME_FACTS.lastVerified}.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-14">
    <div class="mb-4 flex items-center gap-3">
      <h2 class="font-display text-xl font-bold text-ash-50">Confirmed facts</h2>
      <SourceBadge source="official" />
    </div>
    <div class="overflow-hidden rounded-xl border border-ash-800">
      <table class="w-full text-left text-sm">
        <tbody>
          {
            facts.map((f, i) => (
              <tr class={i % 2 === 0 ? 'bg-ash-900/40' : ''}>
                <th scope="row" class="w-44 px-5 py-3 font-display font-semibold text-ash-300">
                  {f.label}
                </th>
                <td class="px-5 py-3 text-ash-100">{f.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-3 text-xs text-ash-500">
      Source:{' '}
      <a
        href={GAME_FACTS.source}
        rel="noopener"
        target="_blank"
        class="underline hover:text-ember-400"
      >
        Official Steam store listing (App {GAME_FACTS.steamAppId})
      </a>
      . Steam shows <strong>coming soon</strong> with date {GAME_FACTS.releaseDateShort}.
    </p>

    <ul class="mt-6 flex flex-wrap gap-2">
      {
        GAME_FACTS.tags.map((t) => (
          <li class="rounded-full border border-ash-700 px-3 py-1 text-xs text-ash-300">
            {t}
          </li>
        ))
      }
    </ul>

    <div class="prose mt-12 max-w-none">
      <h2>The premise</h2>
      <p>
        Beast of Reincarnation is set in a <strong>post-apocalyptic Japan in the year 4026</strong>.
        Humanity's hope rests with two outcasts: <strong>Emma</strong>, shunned for an affliction she carries,
        and <strong>Koo</strong>, a blighted dog. Official copy frames their journey as both lonely and
        companionable, moving through a world where forests can burst to life amid wasteland and wither again.
      </p>
      <p>
        Emma and Koo are tasked with battling Bosses, capturing their powers, and ultimately facing the
        being the game is named for - the <strong>Beast of Reincarnation</strong>. Steam also pitches a
        story where every character hides a dangerous truth.
      </p>

      <h2>Emma and Koo: the hybrid combat system</h2>
      <p>
        The headline mechanic is the bond between Emma and Koo. You fight as a unit: Emma handles sword
        combat while you issue commands to Koo. Game Freak describes this as a
        <strong> hybrid combat system that combines real-time action with turn-based RPG elements</strong>  - 
        the core difference from a straight Souls-like framing.
      </p>

      <h2>Builds and playstyles</h2>
      <p>
        Official materials highlight customization through <strong>skill trees, gear, and spirit stones</strong>.
        Steam calls out three broad loadout directions - <strong>ranged, stealthy, and aggressive</strong>  - 
        so players can define how they approach the world's Bosses.
      </p>

      <h2 id="system-requirements">PC system requirements</h2>
      <p>
        These specs apply to the PC (Steam) version. The Steam listing calls for Windows,
        DirectX 12, 45 GB storage, and an SSD. The PS5 and Xbox Series X|S versions launch
        the same day and are not bound by these PC requirements.
      </p>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-5">
        <h3 class="font-display text-lg font-semibold text-ash-50">Minimum</h3>
        <ul class="mt-3 space-y-2 text-sm text-ash-300">
          <li><strong class="text-ash-100">OS:</strong> {GAME_FACTS.systemRequirements.minimum.os}</li>
          <li><strong class="text-ash-100">CPU:</strong> {GAME_FACTS.systemRequirements.minimum.cpu}</li>
          <li><strong class="text-ash-100">Memory:</strong> {GAME_FACTS.systemRequirements.minimum.memory}</li>
          <li><strong class="text-ash-100">GPU:</strong> {GAME_FACTS.systemRequirements.minimum.gpu}</li>
          <li><strong class="text-ash-100">DirectX:</strong> {GAME_FACTS.systemRequirements.minimum.directx}</li>
          <li><strong class="text-ash-100">Storage:</strong> {GAME_FACTS.systemRequirements.minimum.storage}</li>
          <li><strong class="text-ash-100">Notes:</strong> {GAME_FACTS.systemRequirements.minimum.notes}</li>
        </ul>
      </div>
      <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-5">
        <h3 class="font-display text-lg font-semibold text-ash-50">Recommended</h3>
        <ul class="mt-3 space-y-2 text-sm text-ash-300">
          <li><strong class="text-ash-100">OS:</strong> {GAME_FACTS.systemRequirements.recommended.os}</li>
          <li><strong class="text-ash-100">CPU:</strong> {GAME_FACTS.systemRequirements.recommended.cpu}</li>
          <li><strong class="text-ash-100">Memory:</strong> {GAME_FACTS.systemRequirements.recommended.memory}</li>
          <li><strong class="text-ash-100">GPU:</strong> {GAME_FACTS.systemRequirements.recommended.gpu}</li>
          <li><strong class="text-ash-100">DirectX:</strong> {GAME_FACTS.systemRequirements.recommended.directx}</li>
          <li><strong class="text-ash-100">Storage:</strong> {GAME_FACTS.systemRequirements.recommended.storage}</li>
          <li><strong class="text-ash-100">Notes:</strong> {GAME_FACTS.systemRequirements.recommended.notes}</li>
        </ul>
      </div>
    </div>

    <div class="prose mt-12 max-w-none">
      <h2>Features, languages & editions</h2>
      <p>
        Steam lists full controller support (including DualShock / DualSense notes), Steam Achievements,
        Steam Cloud, adjustable difficulty, subtitle options, and family sharing. Supported languages include
        full audio for English and Japanese, with additional text languages listed on the store page.
      </p>
      <p>
        Two purchase options currently appear on Steam: the standard edition at {GAME_FACTS.priceUsd}
        and a Deluxe Edition at {GAME_FACTS.deluxePriceUsd}. Exact deluxe contents should be checked on the
        store page, as package art may change before launch.
      </p>

      <h2>About our guides</h2>
      <p>
        Because the game is not out yet, every strategy guide on this site is marked as a
        <strong> pre-release preview</strong> - built from official information and community expectations,
        not hands-on play. Those pages stay noindex until we verify them after launch. For planning and SEO,
        treat this Game Info page as the primary source of truth.
      </p>
      <p>
        You can still <a href="/guides/">browse provisional previews</a>, or read our
        <a href="/disclaimer/">editorial disclaimer</a>.
      </p>

      <h2>Frequently asked questions</h2>
    </div>

    <div class="mt-6 space-y-4">
      {
        faq.map((item) => (
          <div class="rounded-xl border border-ash-800 bg-ash-900/30 p-5">
            <h3 class="font-display text-lg font-semibold text-ash-50">{item.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash-300">{item.a}</p>
          </div>
        ))
      }
    </div>

    <div class="prose mt-12 max-w-none">
      <h2>How we label sources</h2>
      <p>
        Every fact and guide carries a source label so you always know how solid the information is  - 
        from officially confirmed to pre-release speculation.
      </p>
    </div>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        (Object.keys(SOURCES) as SourceKey[]).map((key) => (
          <li class="flex flex-col gap-2 rounded-lg border border-ash-800 bg-ash-900/40 p-4">
            <SourceBadge source={key} />
            <span class="text-sm leading-relaxed text-ash-400">{SOURCES[key].blurb}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
