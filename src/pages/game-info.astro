---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceBadge from '../components/SourceBadge.astro';
import {
  SITE,
  GAME_FACTS,
  SOURCES,
  LAUNCH_COPY,
  OFFER_AVAILABILITY,
  PRICE_NUMERIC,
  type SourceKey,
} from '../data/site';

const path = '/game-info/';
const title = 'Beast of Reincarnation Game Info, Specs & Confirmed Facts';
const description =
  'Confirmed Beast of Reincarnation info: out now on PC, PS5 & Xbox, day one on Game Pass, hybrid combat, difficulty options, PC requirements, price and FAQ.';

const facts = [
  { label: 'Release date', value: `${GAME_FACTS.releaseDate} — out now` },
  { label: 'Launch build', value: `Version ${GAME_FACTS.launchVersion}` },
  { label: 'Developer', value: GAME_FACTS.developer },
  { label: 'Publisher', value: GAME_FACTS.publisher },
  { label: 'Platforms', value: GAME_FACTS.platform },
  { label: 'Genre', value: `${GAME_FACTS.genres.join(' / ')}` },
  { label: 'Price', value: `${GAME_FACTS.priceUsd} (Deluxe ${GAME_FACTS.deluxePriceUsd})` },
  { label: 'Xbox Game Pass', value: 'Day one — Ultimate & PC Game Pass' },
  { label: 'Controller', value: GAME_FACTS.controllerSupport },
  { label: 'Difficulty', value: `${GAME_FACTS.difficulties.join(' / ')} — switchable at any time` },
  { label: 'Status', value: LAUNCH_COPY.status },
];

const faq = [
  {
    q: 'When did Beast of Reincarnation release?',
    a: `Beast of Reincarnation released on ${GAME_FACTS.releaseDate}, unlocking at 00:00 UTC in all regions. ${LAUNCH_COPY.storeStatusSentence} The launch build is version ${GAME_FACTS.launchVersion}.`,
  },
  {
    q: 'Who is developing and publishing Beast of Reincarnation?',
    a: `It is developed by ${GAME_FACTS.developer} and published by ${GAME_FACTS.publisher}.`,
  },
  {
    q: 'What platforms is Beast of Reincarnation on?',
    a: `Beast of Reincarnation is out on ${GAME_FACTS.platform} — all three released on ${GAME_FACTS.releaseDate}. On PC it is sold via Steam; the PS5 and Xbox Series X|S versions launched the same day on their own stores.`,
  },
  {
    q: 'Is Beast of Reincarnation on Xbox Game Pass?',
    a: `Yes, on day one. Xbox Wire states the game "will be available with Xbox Game Pass Ultimate on day one, and is an Xbox Play Anywhere and Handheld Optimized title", and Microsoft Store entitlement data for product ${GAME_FACTS.gamePass.productId} lists Xbox Game Pass (console) and PC Game Pass. It covers Xbox consoles and Windows only — there is no subscription route on Steam or PlayStation.`,
  },
  {
    q: 'Is Beast of Reincarnation a Souls-like?',
    a: 'Not exactly. Official copy describes a hybrid combat system that fuses real-time action with turn-based RPG elements, built around Emma and Koo fighting as a unit.',
  },
  {
    q: 'How does the Emma and Koo combat system work?',
    a: GAME_FACTS.combatSummary,
  },
  {
    q: 'What are the PC system requirements?',
    a: `Minimum: ${GAME_FACTS.systemRequirements.minimum.cpu}, ${GAME_FACTS.systemRequirements.minimum.gpu}, 16 GB RAM, 45 GB SSD. Recommended: ${GAME_FACTS.systemRequirements.recommended.cpu}, ${GAME_FACTS.systemRequirements.recommended.gpu}, 16 GB RAM, 45 GB SSD.`,
  },
  {
    q: 'How much does Beast of Reincarnation cost on Steam?',
    a: `Steam lists the standard edition at ${GAME_FACTS.priceUsd} and the Deluxe Edition at ${GAME_FACTS.deluxePriceUsd} (USD, no discount at last check). The Deluxe content also released as a standalone ${GAME_FACTS.deluxeDlc.priceUsd} upgrade DLC, so standard-edition owners can add it afterwards.`,
  },
  {
    q: 'Does Beast of Reincarnation have difficulty options?',
    a: `Yes. Steam lists an Adjustable Difficulty tag, and post-launch coverage names three settings — ${GAME_FACTS.difficulties.join(', ')} — which can be changed at any time. Story reduces incoming damage substantially but still requires parrying and dodging.`,
  },
  {
    q: 'Are the guides on this site confirmed?',
    a: `Partly. Pages badged Hands-on are written from the shipped game with their sources cited on the page. Pages still badged Speculation were written before the ${GAME_FACTS.releaseDateShort} launch from official pre-release materials, carry a notice saying so, and are being rewritten.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: GAME_FACTS.name,
    description,
    url: new URL(path, SITE.url).href,
    genre: GAME_FACTS.genres,
    gamePlatform: ['PC', 'PlayStation 5', 'Xbox Series X|S'],
    datePublished: GAME_FACTS.releaseDateISO,
    author: { '@type': 'Organization', name: GAME_FACTS.developer },
    publisher: { '@type': 'Organization', name: GAME_FACTS.publisher },
    offers: {
      '@type': 'Offer',
      price: PRICE_NUMERIC,
      priceCurrency: 'USD',
      availability: OFFER_AVAILABILITY,
      url: GAME_FACTS.source,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Game Info',
        item: new URL(path, SITE.url).href,
      },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path}>
  <JsonLd slot="head" schema={schema} />

  <section class="relative overflow-hidden border-b border-ash-800">
    <img
      src="/images/beast-of-reincarnation-forest-hero-wide.webp"
      alt="Wide official Beast of Reincarnation key art of Emma standing in a shallow stream inside a towering golden forest"
      width="1600"
      height="517"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover opacity-30"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ash-950 via-ash-950/85 to-ash-950/50"></div>
    <div class="relative mx-auto max-w-4xl px-4 py-14">
      <nav aria-label="Breadcrumb" class="mb-4 text-xs text-ash-400">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="hover:text-ember-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ash-300">Game Info</li>
        </ol>
      </nav>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
          Beast of Reincarnation: Everything Confirmed
        </h1>
        <SourceBadge source="official" />
      </div>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ash-300">
        A living summary of what {GAME_FACTS.developer} and {GAME_FACTS.publisher}
        have published on Steam - release date, combat pillars, story setup, pricing,
        features, and PC requirements. Last verified {GAME_FACTS.lastVerified}.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-14">
    <div class="mb-4 flex items-center gap-3">
      <h2 class="font-display text-xl font-bold text-ash-50">Confirmed facts</h2>
      <SourceBadge source="official" />
    </div>
    <div class="overflow-hidden rounded-xl border border-ash-800">
      <table class="w-full text-left text-sm">
        <tbody>
          {
            facts.map((f, i) => (
              <tr class={i % 2 === 0 ? 'bg-ash-900/40' : ''}>
                <th scope="row" class="w-44 px-5 py-3 font-display font-semibold text-ash-300">
                  {f.label}
                </th>
                <td class="px-5 py-3 text-ash-100">{f.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-3 text-xs text-ash-500">
      Source:{' '}
      <a
        href={GAME_FACTS.source}
        rel="noopener"
        target="_blank"
        class="underline hover:text-ember-400"
      >
        Official Steam store listing (App {GAME_FACTS.steamAppId})
      </a>
      . {LAUNCH_COPY.steamListingNote}
    </p>

    <ul class="mt-6 flex flex-wrap gap-2">
      {
        GAME_FACTS.tags.map((t) => (
          <li class="rounded-full border border-ash-700 px-3 py-1 text-xs text-ash-300">
            {t}
          </li>
        ))
      }
    </ul>

    <div class="prose mt-12 max-w-none">
      <h2>The premise</h2>
      <p>
        Beast of Reincarnation is set in a <strong>post-apocalyptic Japan in the year 4026</strong>.
        Humanity's hope rests with two outcasts: <strong>Emma</strong>, shunned for an affliction she carries,
        and <strong>Koo</strong>, a blighted dog. Official copy frames their journey as both lonely and
        companionable, moving through a world where forests can burst to life amid wasteland and wither again.
      </p>
      <p>
        Emma and Koo are tasked with battling Bosses, capturing their powers, and ultimately facing the
        being the game is named for - the <strong>Beast of Reincarnation</strong>. Steam also pitches a
        story where every character hides a dangerous truth.
      </p>

      <h2>Emma and Koo: the hybrid combat system</h2>
      <p>
        The headline mechanic is the bond between Emma and Koo. You fight as a unit: Emma handles sword
        combat while you issue commands to Koo. Game Freak describes this as a
        <strong> hybrid combat system that combines real-time action with turn-based RPG elements</strong>  - 
        the core difference from a straight Souls-like framing.
      </p>

      <figure>
        <img
          src="/images/beast-of-reincarnation-koo-blighted-wolf.webp"
          alt="Official Beast of Reincarnation render of Koo as a dark-furred wolf with red blighted foliage growing along his back and tail"
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
          class="rounded-xl border border-ash-800"
        />
        <figcaption>
          Koo in the official store gallery. Steam calls him "the blighted dog"; the foliage growing
          along his back and tail is part of that design. Source: official PlayStation Store listing.
        </figcaption>
      </figure>

      <h2>Builds and playstyles</h2>
      <p>
        Official materials highlight customization through <strong>skill trees, gear, and spirit stones</strong>.
        Steam calls out three broad loadout directions - <strong>ranged, stealthy, and aggressive</strong>  - 
        so players can define how they approach the world's Bosses.
      </p>

      <h2 id="system-requirements">PC system requirements</h2>
      <p>
        These specs apply to the PC (Steam) version. The Steam listing calls for Windows,
        DirectX 12, 45 GB storage, and an SSD. The PS5 and Xbox Series X|S versions launch
        the same day and are not bound by these PC requirements.
      </p>
    </div>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-5">
        <h3 class="font-display text-lg font-semibold text-ash-50">Minimum</h3>
        <ul class="mt-3 space-y-2 text-sm text-ash-300">
          <li><strong class="text-ash-100">OS:</strong> {GAME_FACTS.systemRequirements.minimum.os}</li>
          <li><strong class="text-ash-100">CPU:</strong> {GAME_FACTS.systemRequirements.minimum.cpu}</li>
          <li><strong class="text-ash-100">Memory:</strong> {GAME_FACTS.systemRequirements.minimum.memory}</li>
          <li><strong class="text-ash-100">GPU:</strong> {GAME_FACTS.systemRequirements.minimum.gpu}</li>
          <li><strong class="text-ash-100">DirectX:</strong> {GAME_FACTS.systemRequirements.minimum.directx}</li>
          <li><strong class="text-ash-100">Storage:</strong> {GAME_FACTS.systemRequirements.minimum.storage}</li>
          <li><strong class="text-ash-100">Notes:</strong> {GAME_FACTS.systemRequirements.minimum.notes}</li>
        </ul>
      </div>
      <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-5">
        <h3 class="font-display text-lg font-semibold text-ash-50">Recommended</h3>
        <ul class="mt-3 space-y-2 text-sm text-ash-300">
          <li><strong class="text-ash-100">OS:</strong> {GAME_FACTS.systemRequirements.recommended.os}</li>
          <li><strong class="text-ash-100">CPU:</strong> {GAME_FACTS.systemRequirements.recommended.cpu}</li>
          <li><strong class="text-ash-100">Memory:</strong> {GAME_FACTS.systemRequirements.recommended.memory}</li>
          <li><strong class="text-ash-100">GPU:</strong> {GAME_FACTS.systemRequirements.recommended.gpu}</li>
          <li><strong class="text-ash-100">DirectX:</strong> {GAME_FACTS.systemRequirements.recommended.directx}</li>
          <li><strong class="text-ash-100">Storage:</strong> {GAME_FACTS.systemRequirements.recommended.storage}</li>
          <li><strong class="text-ash-100">Notes:</strong> {GAME_FACTS.systemRequirements.recommended.notes}</li>
        </ul>
      </div>
    </div>

    <div class="prose mt-12 max-w-none">
      <h2>Features and languages</h2>
      <p>
        Steam lists full controller support (including DualShock / DualSense notes), Steam Achievements,
        Steam Cloud, adjustable difficulty, subtitle options, and family sharing. Supported languages include
        full audio for English and Japanese, with additional text languages listed on the store page.
      </p>

      <h2 id="price">Price and editions</h2>
      <p>
        Two purchase options appear on Steam: the standard edition at
        {' '}<strong>{GAME_FACTS.priceUsd}</strong> and a Deluxe Edition at
        {' '}<strong>{GAME_FACTS.deluxePriceUsd}</strong> (USD). Regional pricing varies —
        those are the figures on the store page as of {GAME_FACTS.lastVerified}.
      </p>
      <p>
        Per the official pre-order post, Deluxe adds an Alternate Black Shiba Skin for Koo, a Big
        Dipper sword and Oni's Hat for Emma, 100,000 Amber (vs 30,000 standard), and Vegetable
        Seedlings. Both editions include the Alternate Brown Shiba Skin for Koo as the pre-order
        bonus.
      </p>
      <p>
        Worth weighing against those prices: on Xbox consoles and Windows the game is in the
        {' '}<a href="#game-pass">Game Pass catalogue from day one</a>, so a subscription is an
        alternative to buying it outright. That does not apply to Steam or PlayStation 5.
      </p>

      <h2 id="game-pass">Xbox Game Pass, Play Anywhere &amp; handheld</h2>
      <p>
        On the Xbox side there is more confirmed than the Steam listing shows.
        {' '}{GAME_FACTS.gamePass.summary} The wording on
        {' '}<a href={GAME_FACTS.gamePass.wireUrl} rel="noopener" target="_blank">Xbox Wire</a> is
        that the game "will be available with Xbox Game Pass Ultimate on day one, and is an Xbox Play
        Anywhere and Handheld Optimized title"; the
        {' '}<a href={GAME_FACTS.gamePass.storeUrl} rel="noopener" target="_blank">official Xbox game
        page</a> carries "Play day one with Game Pass". Microsoft's store entitlement data for product
        {' '}{GAME_FACTS.gamePass.productId} names both subscriptions — Xbox Game Pass (console) and
        PC Game Pass.
      </p>
      <p>
        The Xbox store lists these capabilities for it:
        {' '}{GAME_FACTS.gamePass.xboxCapabilities.join(', ')}. Play Anywhere means a single
        entitlement spans Xbox console and Windows, and the Developer_Direct post also names Xbox
        Cloud, so Ultimate subscribers get a streaming option.
      </p>
      <p>
        What this does <em>not</em> mean: Game Pass has no bearing on the Steam or PlayStation 5
        versions, and a subscription is not a purchase — no one has said how long the game stays in
        the catalogue. Buying it outright on Steam at {GAME_FACTS.priceUsd} is still the only route
        that is unambiguously permanent.
      </p>

      <h2>About our guides</h2>
      <p>
        {LAUNCH_COPY.guidesCaveat} Pages that have been rewritten from the shipped game carry a
        <strong>Hands-on</strong> badge and list the coverage each detail came from at the bottom of
        the page; anything still badged <strong>Speculation</strong> shows a notice saying it predates
        launch. This Game Info page remains the store-verified baseline.
      </p>
      <p>
        Start with the <a href="/guides/launch-day-beginner-guide/">beginner's guide</a> for the
        systems in the released build, or the <a href="/guides/nushi-boss-fight/">Rangifer Nushi
        fight</a>. You can also <a href="/guides/">browse every guide</a>, or read our
        <a href="/disclaimer/">editorial disclaimer</a>.
      </p>
      <p>
        For the confirmed narrative setup - Year 4026, Emma's affliction, Koo the blighted dog, and
        the Bosses standing between them and the Beast - see our
        <a href="/guides/story-and-setting/">story and setting page</a>, which is built from official
        material only.
      </p>

      <h2>Frequently asked questions</h2>
    </div>

    <div class="mt-6 space-y-4">
      {
        faq.map((item) => (
          <div class="rounded-xl border border-ash-800 bg-ash-900/30 p-5">
            <h3 class="font-display text-lg font-semibold text-ash-50">{item.q}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ash-300">{item.a}</p>
          </div>
        ))
      }
    </div>

    <div class="prose mt-12 max-w-none">
      <h2>How we label sources</h2>
      <p>
        Every fact and guide carries a source label so you always know how solid the information is  -
        from officially confirmed, through hands-on coverage of the shipped game, down to pages
        written before release.
      </p>
    </div>

    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {
        (Object.keys(SOURCES) as SourceKey[]).map((key) => (
          <li class="flex flex-col gap-2 rounded-lg border border-ash-800 bg-ash-900/40 p-4">
            <SourceBadge source={key} />
            <span class="text-sm leading-relaxed text-ash-400">{SOURCES[key].blurb}</span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
