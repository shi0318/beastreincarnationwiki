---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import WikiSectionNav from '../../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../../data/site';

const path = '/characters/emma/';
const title = 'Beast of Reincarnation Emma Guide: Skills, Weapons & Combat Role';
const description =
  'Beast of Reincarnation Emma guide covering her sword and ranged weapons, Hair movement, Entanglement Overdrive, Track Shot and build priorities.';
const image = '/images/beast-of-reincarnation-emma-character.webp';
const canonical = new URL(path, SITE.url).href;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, url: canonical,
    about: { '@type': 'Person', name: 'Emma' }, isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Characters', item: new URL('/characters/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: 'Emma', item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path} image={image} imageAlt="Emma, protagonist of Beast of Reincarnation, holding her sword">
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30"><div class="mx-auto max-w-6xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400"><a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span><a href="/characters/" class="hover:text-ember-400">Characters</a><span aria-hidden="true"> / </span><span class="text-ash-300">Emma</span></nav>
    <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">Beast of Reincarnation Emma Guide: Skills, Weapons &amp; Combat Role</h1>
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">Emma is the direct-action half of the Beast of Reincarnation team. Her sword attacks, ranged weapons, Hair traversal and Entanglement tools determine how you create openings while Koo supplies techniques and Bloom Arts.</p>
  </div></section>
  <main class="mx-auto max-w-5xl px-4 py-12"><WikiSectionNav active="/characters/" />
    <section class="mt-10 grid gap-6 md:grid-cols-2"><div class="rounded-xl border border-ash-800 bg-ash-900/40 p-6"><h2 class="font-display text-2xl font-bold text-ash-50">Emma's main systems</h2><ul class="mt-4 space-y-3 text-ash-300"><li><strong class="text-ash-100">Weapons:</strong> Mechblade forms, named swords and the Spring Thunder Crossbow.</li><li><strong class="text-ash-100">Movement:</strong> Hair abilities support Lift, Extend and air-assassination routes.</li><li><strong class="text-ash-100">Skill trees:</strong> Entanglement Overdrive, Hair and Track Shot are the key paths documented by the cited progression guide.</li><li><strong class="text-ash-100">Resources:</strong> Parrying feeds Emma's entanglement loop while also helping Koo.</li></ul></div><div class="rounded-xl border border-ash-800 bg-ash-900/40 p-6"><h2 class="font-display text-2xl font-bold text-ash-50">Emma guide links</h2><ul class="mt-4 space-y-3 text-ash-300"><li><a class="text-ember-400 hover:text-ember-300" href="/weapons/">Beast of Reincarnation weapons list</a></li><li><a class="text-ember-400 hover:text-ember-300" href="/weapons/blades/">Blade count and NG+ guide</a></li><li><a class="text-ember-400 hover:text-ember-300" href="/guides/lift-extend-traversal-guide/">Lift and Extend traversal guide</a></li><li><a class="text-ember-400 hover:text-ember-300" href="/guides/parry-guard-dodge-controls-guide/">Parry, guard and dodge controls</a></li><li><a class="text-ember-400 hover:text-ember-300" href="/skills/emma-skill-tree/">Emma skill tree guide</a></li></ul></div></section>
    <section class="mt-12 rounded-xl border border-ash-800 bg-ash-900/40 p-6"><h2 class="font-display text-2xl font-bold text-ash-50">Emma build advice without unsupported numbers</h2><p class="mt-3 leading-relaxed text-ash-300">Start with the problem you are trying to solve. If Emma cannot escape, investigate the Track Shot roll and Hair movement paths. If a boss fight is too slow, compare the weapon element and the target's visible weakness before spending points. If the entanglement gauge is empty, practise the parry window instead of assuming a higher-damage weapon will fix the loop.</p></section>
    <p class="mt-8 border-t border-ash-800 pt-5 text-sm leading-relaxed text-ash-500">Emma and Koo's official combat relationship is described on the <a class="text-ember-400 hover:text-ember-300" href={GAME_FACTS.source} rel="noopener" target="_blank">Beast of Reincarnation Steam page</a>. Skill-path recommendations are linked to their source and are not presented as a personal full-game clear.</p>
  </main>
</BaseLayout>
