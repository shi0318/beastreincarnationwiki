---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import SourceBadge from '../../components/SourceBadge.astro';
import WikiSectionNav from '../../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../../data/site';
import { COLLECTIBLE_DETAILS } from '../../data/section-pages';

export function getStaticPaths() {
  return COLLECTIBLE_DETAILS.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const path = `/collectibles/${item.slug}/`;
const canonical = new URL(path, SITE.url).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: item.title,
    description: item.description,
    url: canonical,
    image: new URL(item.image, SITE.url).href,
    about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Collectibles', item: new URL('/collectibles/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: item.name, item: canonical },
    ],
  },
];
---

<BaseLayout title={item.title} description={item.description} path={path} image={item.image} imageAlt={item.imageAlt} ogType="article" updateDate={new Date('2026-09-16T00:00:00Z')}>
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400">
        <a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span>
        <a href="/collectibles/" class="hover:text-ember-400">Collectibles</a><span aria-hidden="true"> / </span>
        <span class="text-ash-300">{item.name}</span>
      </nav>
      <SourceBadge source="community" showBlurb />
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">{item.title}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">{item.intro}</p>
    </div>
  </section>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <WikiSectionNav active="/collectibles/" />
    <section class="mt-10 grid gap-8 md:grid-cols-[1.1fr_.9fr]">
      <div>
        <h2 class="font-display text-2xl font-bold text-ash-50">{item.name} facts</h2>
        <div class="mt-5 overflow-hidden rounded-xl border border-ash-800">
          <table class="w-full text-left text-sm">
            <tbody>
              {item.facts.map((fact) => (
                <tr class="border-t border-ash-800 first:border-t-0">
                  <th scope="row" class="w-2/5 bg-ash-900/60 px-4 py-3 font-medium text-ash-200">{fact.label}</th>
                  <td class="px-4 py-3 text-ash-300">{fact.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <img src={item.image} alt={item.imageAlt} width="1600" height="900" loading="eager" fetchpriority="high" class="rounded-xl border border-ash-800 object-cover" />
    </section>
    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ash-50">How to track this category</h2>
      <ol class="mt-5 space-y-4 text-ash-300">
        {item.steps.map((step, index) => (
          <li class="flex gap-3">
            <span class="font-display font-bold text-ember-400">{index + 1}.</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </section>
    <section class="mt-12 rounded-xl border border-ash-800 bg-ash-900/40 p-6">
      <h2 class="font-display text-xl font-bold text-ash-50">What is not published</h2>
      <p class="mt-3 leading-relaxed text-ash-300">{item.evidence}</p>
    </section>
    <p class="mt-8 text-sm text-ash-400">
      <a href="/collectibles/" class="text-ember-400 hover:underline">All collectibles</a>
      {' · '}
      <a href={item.guideHref} class="text-ember-400 hover:underline">Full {item.name} workflow</a>
    </p>
  </main>
</BaseLayout>
