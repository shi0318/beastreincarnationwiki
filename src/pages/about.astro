---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, GAME_FACTS } from '../data/site';

const path = '/about/';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${SITE.name}`,
    url: new URL(path, SITE.url).href,
    description: `About ${SITE.name} - how we cover Beast of Reincarnation before and after launch.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'About', item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout
  title="About Us"
  description={`About ${SITE.name}: a community wiki focused on confirmed Beast of Reincarnation facts first, with clearly labeled pre-release previews until launch.`}
  path={path}
>
  <JsonLd slot="head" schema={schema} />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-ash-400">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-ember-400">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ash-300">About</li>
      </ol>
    </nav>

    <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
      About {SITE.name}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ash-300">
      {SITE.name} helps players track what is confirmed about Beast of Reincarnation and prepare for launch
      without treating speculation as hands-on fact.
    </p>

    <div class="prose mt-10 max-w-none">
      <h2>What we prioritize</h2>
      <ul>
        <li><strong>Confirmed game info</strong> - release date, developer, combat pillars, PC specs, and Steam features.</li>
        <li><strong>Source labels</strong> - every page shows how solid the information is.</li>
        <li><strong>Pre-release honesty</strong> - strategy outlines stay provisional and noindex until verified after launch.</li>
        <li><strong>Post-launch rewrites</strong> - real boss, combat, and exploration guides will replace previews after {GAME_FACTS.releaseDate}.</li>
      </ul>

      <h2>How we write before launch</h2>
      <p>
        Before the game is out, we do not claim hands-on testing. Official Steam copy, trailers, and clearly
        marked analysis are the only foundations we use. If something is expected rather than confirmed, we say so.
      </p>

      <h2>Ownership</h2>
      <p>
        {SITE.name} is an unofficial fan-made resource. We are not affiliated with or endorsed by
        {GAME_FACTS.developer}, {GAME_FACTS.publisher}, or Steam. All trademarks remain the property of their
        respective owners.
      </p>

      <h2>Get in touch</h2>
      <p>
        Spotted an error, have a correction, or want to suggest a post-launch guide? Visit our
        <a href="/contact/">contact page</a>. Editorial rules live on the
        <a href="/disclaimer/">disclaimer</a> page.
      </p>
    </div>
  </section>
</BaseLayout>
