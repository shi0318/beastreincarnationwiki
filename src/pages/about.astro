---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, GAME_FACTS } from '../data/site';

const path = '/about/';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${SITE.name}`,
    url: new URL(path, SITE.url).href,
    description: `About ${SITE.name} - how we cover Beast of Reincarnation now that it is out, and how we label what is verified.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'About', item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout
  title="About Us"
  description={`About ${SITE.name}: a community wiki that puts confirmed Beast of Reincarnation facts first and labels every page by how solid its sourcing is.`}
  path={path}
>
  <JsonLd slot="head" schema={schema} />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-ash-400">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-ember-400">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ash-300">About</li>
      </ol>
    </nav>

    <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
      About {SITE.name}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ash-300">
      {SITE.name} helps players get through Beast of Reincarnation — out since
      {' '}{GAME_FACTS.releaseDateShort} — without treating speculation as hands-on fact.
    </p>

    <div class="prose mt-10 max-w-none">
      <h2>What we prioritize</h2>
      <ul>
        <li><strong>Confirmed game info</strong> - release date, developer, combat pillars, PC specs, and Steam features.</li>
        <li><strong>Source labels</strong> - every page shows how solid the information is.</li>
        <li><strong>Named sources</strong> - guides written from the shipped game list the coverage each detail came from at the bottom of the page.</li>
        <li><strong>Honest labelling</strong> - pages written before the {GAME_FACTS.releaseDateShort} launch keep a notice saying so until they are rewritten, rather than being quietly re-dated.</li>
      </ul>

      <h2>How we label a page</h2>
      <p>
        Three tiers do most of the work. <strong>Official</strong> means it is on the Steam listing or
        in a first-party announcement. <strong>Hands-on</strong> means it describes the shipped game
        and cites the post-launch coverage it came from. <strong>Speculation</strong> means it was
        written before release from trailers and store copy, and has not been checked against the real
        build. We do not claim to have personally played through content we have not, and we do not
        publish tier lists or drop tables that no source supports.
      </p>

      <h2>Ownership</h2>
      <p>
        {SITE.name} is an unofficial fan-made resource. We are not affiliated with or endorsed by
        {GAME_FACTS.developer}, {GAME_FACTS.publisher}, or Steam. All trademarks remain the property of their
        respective owners.
      </p>

      <h2>Get in touch</h2>
      <p>
        Spotted an error, have a correction, or want to suggest a guide? Visit our
        <a href="/contact/">contact page</a>. Editorial rules live on the
        <a href="/disclaimer/">disclaimer</a> page, and the current starting points are the
        <a href="/guides/launch-day-beginner-guide/">beginner's guide</a> and the
        <a href="/game-info/">confirmed game info</a>.
      </p>
    </div>
  </section>
</BaseLayout>
