---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceBadge from '../components/SourceBadge.astro';
import WikiSectionNav from '../components/WikiSectionNav.astro';
import { GAME_FACTS, SITE } from '../data/site';

const path = '/walkthrough/';
const title = 'Beast of Reincarnation Walkthrough: All 13 Chapters & Epilogue';
const description =
  'Beast of Reincarnation walkthrough and chapter list: all 13 main chapters, the Bearing Fruit epilogue, story order, chapter length and source boundaries.';
const image = '/images/beast-of-reincarnation-header-banner.webp';
const chapters = [
  ['Chapter 1', 'Seedling'], ['Chapter 2', 'Creeping Tendrils'], ['Chapter 3', 'The Vessel'],
  ['Chapter 4', 'Stems'], ['Chapter 5', 'Branching Paths'], ['Chapter 6', 'Necrosis'],
  ['Chapter 7', 'Root Rot'], ['Chapter 8', 'Worm Food'], ['Chapter 9', 'Branching Out'],
  ['Chapter 10', 'Malefact'], ['Chapter 11', 'Budding Realization'], ['Chapter 12', 'The Firmament'],
  ['Chapter 13', 'To Bloom, Then Fall'],
] as const;
const canonical = new URL(path, SITE.url).href;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: canonical,
    about: { '@type': 'VideoGame', name: GAME_FACTS.name, url: GAME_FACTS.source },
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    mainEntity: { '@type': 'ItemList', numberOfItems: chapters.length + 1, itemListElement: [...chapters.map(([chapter, name], index) => ({ '@type': 'ListItem', position: index + 1, name: `${chapter}: ${name}` })), { '@type': 'ListItem', position: 14, name: 'Epilogue: Bearing Fruit' }] },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: 'Walkthrough', item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} path={path} image={image} imageAlt="Beast of Reincarnation landscape and ruined tower">
  <JsonLd slot="head" schema={schema} />
  <section class="border-b border-ash-800 bg-ash-900/30">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <nav aria-label="Breadcrumb" class="mb-5 text-xs text-ash-400"><a href="/" class="hover:text-ember-400">Home</a><span aria-hidden="true"> / </span><a href="/guides/" class="hover:text-ember-400">Guides</a><span aria-hidden="true"> / </span><span class="text-ash-300">Walkthrough</span></nav>
      <SourceBadge source="third-party-tested" showBlurb />
      <h1 class="mt-4 font-display text-3xl font-bold leading-tight text-ash-50 md:text-5xl">Beast of Reincarnation Walkthrough: All 13 Chapters &amp; Epilogue</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ash-300">This Beast of Reincarnation walkthrough answers the chapter-list search first: the released game has 13 main chapters followed by the Bearing Fruit epilogue. Use the order below as the spoiler-aware roadmap while deeper chapter pages are verified.</p>
    </div>
  </section>

  <main class="mx-auto max-w-5xl px-4 py-12">
    <WikiSectionNav active={path} />
    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold text-ash-50">Beast of Reincarnation chapter list</h2>
      <div class="mt-6 overflow-x-auto rounded-xl border border-ash-800">
        <table class="w-full min-w-[480px] text-left text-sm">
          <thead class="bg-ash-900 text-ash-200"><tr><th class="px-4 py-3">Order</th><th class="px-4 py-3">Chapter title</th><th class="px-4 py-3">Guide status</th></tr></thead>
          <tbody>
            {chapters.map(([chapter, name], index) => (
              <tr class="border-t border-ash-800"><th scope="row" class="px-4 py-3 font-medium text-ash-100"><a class="text-ember-400 hover:text-ember-300" href={`/walkthrough/chapter-${index + 1}/`}>{chapter}</a></th><td class="px-4 py-3 text-ash-300">{name}</td><td class="px-4 py-3 text-ash-500">Steam-sourced chapter checklist</td></tr>
            ))}
            <tr class="border-t border-ash-800"><th scope="row" class="px-4 py-3 font-medium text-ash-100">Epilogue</th><td class="px-4 py-3 text-ash-300">Bearing Fruit</td><td class="px-4 py-3 text-ash-500">Post-game reference</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12 grid gap-6 md:grid-cols-2">
      <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-6">
        <h2 class="font-display text-xl font-bold text-ash-50">How long is the Beast of Reincarnation story?</h2>
        <p class="mt-3 leading-relaxed text-ash-300">Current hands-on chapter coverage estimates roughly 20–30 hours for the main story and around 30–40 hours for a more completionist run. Treat those as editorial estimates that can change with difficulty, exploration and update patches, not a developer-published timer.</p>
      </div>
      <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-6">
        <h2 class="font-display text-xl font-bold text-ash-50">Useful Beast of Reincarnation route guides</h2>
        <ul class="mt-4 space-y-2 text-ash-300">
          <li><a class="text-ember-400 hover:text-ember-300" href="/guides/interactive-map-guide/">Interactive map and region navigation</a></li>
          <li><a class="text-ember-400 hover:text-ember-300" href="/guides/wayside-shrines-guide/">Shrine locations and return points</a></li>
          <li><a class="text-ember-400 hover:text-ember-300" href="/guides/keeper-golems-locations/">Keeper Golem locations and upgrade materials</a></li>
        </ul>
      </div>
    </section>

    <section class="mt-12 border-t border-ash-800 pt-6 text-sm leading-relaxed text-ash-400">
      <h2 class="font-display text-xl font-bold text-ash-200">Sources and spoiler policy</h2>
      <p class="mt-2">Checked August 17, 2026. Chapter names, the 13-chapter count, epilogue name and time estimates are referenced from <a class="text-ember-400 hover:text-ember-300" href="https://game8.co/games/Beast-of-Reincarnation/archives/613632" rel="noopener" target="_blank">Game8's chapter list</a>. The official <a class="text-ember-400 hover:text-ember-300" href={GAME_FACTS.source} rel="noopener" target="_blank">Steam page</a> confirms the game's setting and story premise, but does not publish a complete chapter guide. This page does not claim that every chapter route has been personally cleared by this site.</p>
    </section>
  </main>
</BaseLayout>
