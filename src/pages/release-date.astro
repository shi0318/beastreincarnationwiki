---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SourceBadge from '../components/SourceBadge.astro';
import { SITE, GAME_FACTS, IS_RELEASED, LAUNCH_COPY } from '../data/site';

const path = '/release-date/';
const canonical = new URL(path, SITE.url).href;

const title = `Beast of Reincarnation Release Date — ${GAME_FACTS.releaseDateShort}`;
const description = `Beast of Reincarnation ${IS_RELEASED ? 'released' : 'releases'} ${GAME_FACTS.releaseDate} on PC, PS5 and Xbox Series X|S, and day one on Xbox Game Pass. Confirmed platforms, price and ${IS_RELEASED ? 'availability' : 'pre-purchase'} status.`;

const rows = [
  {
    label: 'Release date',
    value: `${GAME_FACTS.releaseDate} (00:00 UTC in all regions)${IS_RELEASED ? ' — out now' : ''}`,
  },
  { label: 'Platforms', value: GAME_FACTS.platform },
  { label: 'Standard edition', value: GAME_FACTS.priceUsd },
  { label: 'Deluxe edition', value: GAME_FACTS.deluxePriceUsd },
  { label: 'Xbox Game Pass', value: 'Day one — Ultimate & PC Game Pass' },
  { label: 'Developer', value: GAME_FACTS.developer },
  { label: 'Publisher', value: GAME_FACTS.publisher },
  { label: 'Genre', value: GAME_FACTS.genre },
  ...(IS_RELEASED ? [{ label: 'Launch build', value: `Version ${GAME_FACTS.launchVersion}` }] : []),
  { label: IS_RELEASED ? 'Availability' : 'Pre-purchase', value: IS_RELEASED ? 'Out now on Steam' : 'Live now on Steam' },
];

const faqs = [
  {
    q: 'When does Beast of Reincarnation come out?',
    a: IS_RELEASED
      ? `Beast of Reincarnation is out now — it released on ${GAME_FACTS.releaseDate}, unlocking simultaneously at 00:00 UTC in all regions, so there was no regional stagger. The Steam store page displays "Aug 3, 2026" for some regions because of how Valve renders the local time of that UTC moment; the unlock itself was the same instant worldwide. The launch build is version ${GAME_FACTS.launchVersion}.`
      : `Beast of Reincarnation releases on ${GAME_FACTS.releaseDate}. The official announcement gives a simultaneous unlock at 00:00 UTC in all regions, so there is no regional stagger. The Steam store page displays "Aug 3, 2026" for some regions because of how Valve renders the local time of that UTC moment — the unlock itself is the same instant worldwide.`,
  },
  {
    q: 'What platforms is Beast of Reincarnation on?',
    a: `All three platforms ${IS_RELEASED ? 'released' : 'launch'} together: PC via Steam, PlayStation 5, and Xbox Series X|S. The Steam page lists only PC because that is the only version sold on Steam — the PS5 and Xbox wording that appears there refers to controller compatibility, not platform availability.`,
  },
  {
    q: 'Is it on Nintendo Switch or Switch 2?',
    a: 'No Nintendo version has been announced. Given that Game Freak is the developer, people reasonably expect one, but there is no official listing, so we are not going to imply one exists. If a Nintendo page appears, this page is updated the same day with the source.',
  },
  {
    q: 'Is Beast of Reincarnation on Xbox Game Pass?',
    a: `Yes, and on day one. Xbox Wire's Developer_Direct post states the game "will be available with Xbox Game Pass Ultimate on day one, and is an Xbox Play Anywhere and Handheld Optimized title", and the official xbox.com game page carries the line "Play day one with Game Pass · Available August 4, 2026". The Microsoft Store entitlement data for product ${GAME_FACTS.gamePass.productId} lists both Xbox Game Pass (console) and PC Game Pass. Note this covers Xbox consoles and Windows only — there is no subscription route on Steam or PlayStation.`,
  },
  {
    q: 'How much does Beast of Reincarnation cost?',
    a: `The standard edition is ${GAME_FACTS.priceUsd} and the Deluxe edition is ${GAME_FACTS.deluxePriceUsd} on Steam. ${LAUNCH_COPY.storeStatusSentence} Regional pricing varies; those are the USD figures on the store page as of ${GAME_FACTS.lastVerified}. The Deluxe content also ${IS_RELEASED ? 'released as' : 'exists as'} a standalone ${GAME_FACTS.deluxeDlc.priceUsd} upgrade DLC, so standard-edition owners can add it afterwards. If you subscribe to Xbox Game Pass Ultimate or PC Game Pass you can play it at no extra cost instead of buying it.`,
  },
  {
    q: 'Is there a demo or a beta?',
    a: IS_RELEASED
      ? 'No demo, beta, or public test build was ever released. The full game is the only playable version, so any site offering a separate "free download" is not distributing this game.'
      : 'No demo, beta, or public test build has been announced. There is nothing playable before launch, which also means any site offering a "download" today is not distributing this game.',
  },
  ...(IS_RELEASED
    ? []
    : [
        {
          q: 'Could the release date still change?',
          a: `It could. ${GAME_FACTS.releaseDateShort} is the date on live store listings, which is the strongest signal available short of the game actually shipping. If it moves, this page changes with it.`,
        },
      ]),
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: canonical,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Release Date', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  image="/images/beast-of-reincarnation-emma-character.webp"
  imageAlt="Official character render of Emma from Beast of Reincarnation"
>
  <JsonLd slot="head" schema={schema} />

  <section class="mx-auto max-w-3xl px-4 py-16">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-ash-400">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-ember-400">Home</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-ash-300">Release Date</li>
      </ol>
    </nav>

    <div class="mb-4 flex flex-wrap items-center gap-3">
      <SourceBadge source="official" />
      <span class="text-xs text-ash-500">Verified from official sources on {GAME_FACTS.lastVerified}</span>
    </div>

    <h1 class="font-display text-3xl font-bold leading-tight text-ash-50 md:text-4xl">
      Beast of Reincarnation Release Date
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ash-300">
      <strong class="text-ash-50">
        Beast of Reincarnation {IS_RELEASED ? 'released' : 'releases'} {GAME_FACTS.releaseDate}
      </strong> on
      PC (Steam), PlayStation 5, and Xbox Series X|S, at {GAME_FACTS.priceUsd} for the standard
      edition. {LAUNCH_COPY.notOutYetNote || LAUNCH_COPY.storeStatusSentence}
    </p>

    <figure class="mt-8 overflow-hidden rounded-xl border border-ash-800 bg-ash-900/40">
      <img
        src="/images/beast-of-reincarnation-emma-character.webp"
        alt="Official Beast of Reincarnation character render of Emma in a wide-brimmed straw hat and dark coat with her sword drawn"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full"
      />
      <figcaption class="px-5 py-3 text-xs leading-relaxed text-ash-500">
        Emma, the outcast protagonist, in the official character render used across the PlayStation
        and Xbox store listings for the {GAME_FACTS.releaseDateShort} launch.
      </figcaption>
    </figure>

    <dl class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        rows.map((r) => (
          <div class="rounded-xl border border-ash-800 bg-ash-900/40 p-4">
            <dt class="text-xs font-semibold uppercase tracking-wide text-ash-500">{r.label}</dt>
            <dd class="mt-1.5 font-display text-base font-semibold leading-snug text-ash-50">{r.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="prose mt-10 max-w-none">
      <h2>Why you may see two different dates</h2>
      <p>
        Official communication and platform data both give <strong>{GAME_FACTS.releaseDate}</strong>,
        with a single global unlock at 00:00 UTC. Steam renders that instant in your local time, which
        is why some regions see "Aug 3, 2026" on the store page. Nothing is staggered — everyone
        unlocks at the same moment. We treat the official announcement as authoritative and note the
        Steam display quirk rather than pretending it does not exist.
      </p>

      <h2>What {IS_RELEASED ? 'shipped' : 'launches'} on day one</h2>
      <p>
        {GAME_FACTS.shortDescription} The {IS_RELEASED ? 'launch build (version ' + GAME_FACTS.launchVersion + ') includes' : 'launch build includes'} the full single-player campaign with
        {' '}{GAME_FACTS.controllerSupport.toLowerCase()}, Steam Achievements, Steam Cloud, and
        adjustable difficulty — {GAME_FACTS.difficulties.join(', ')}, switchable at any time. Full
        audio ships in English and Japanese, with subtitles in a further eight languages. One quirk
        worth knowing: the audio language can only be set from the main menu, not the in-game options.
      </p>
      <p>
        The systems confirmed by the developer are hybrid real-time and turn-based combat with Emma
        and Koo fighting as a unit, boss encounters whose powers you capture, and build customisation
        through skill trees, gear, and spirit stones. Everything store-verified sits on the
        {' '}<a href="/game-info/">game info page</a>. For how those systems actually behave in the
        shipped build — the parry, florescence points, bloom arts and entanglement — see the
        {' '}<a href="/guides/launch-day-beginner-guide/">beginner's guide</a>; pages we have not yet
        rewritten from the released game remain labelled as speculation.
      </p>

      <h2>Where to buy{IS_RELEASED ? '' : ', pre-purchase,'} or play on Game Pass</h2>
      <p>
        The only official PC storefront is the
        {' '}<a href={GAME_FACTS.source} rel="noopener" target="_blank">Steam store page</a> (App
        {' '}{GAME_FACTS.steamAppId}). PS5 and Xbox Series X|S versions are sold on their own
        platform stores. Our <a href="/download/">download page</a> covers install size and PC
        requirements.
      </p>
      <p>
        You may not need to buy it at all on Xbox or Windows.
        {' '}<strong>Beast of Reincarnation is on Xbox Game Pass from day one</strong> — Xbox Wire's
        Developer_Direct post says it "will be available with Xbox Game Pass Ultimate on day one, and
        is an Xbox Play Anywhere and Handheld Optimized title", and the
        {' '}<a href={GAME_FACTS.gamePass.storeUrl} rel="noopener" target="_blank">official Xbox game
        page</a> states "Play day one with Game Pass". Microsoft's own store entitlement data lists
        both Xbox Game Pass (console) and PC Game Pass. Because it is an Xbox Play Anywhere title, a
        purchase or a subscription covers console and PC together, and it is flagged
        {' '}<strong>Handheld optimized</strong> for devices like the ROG Xbox Ally.
      </p>
      <p>
        Two things worth being clear about: Game Pass does not touch the Steam or PlayStation
        versions — there is no subscription route on either — and a subscription is not a purchase,
        so access lasts as long as the game stays in the catalogue.
      </p>

      <h2>Frequently asked questions</h2>
      {
        faqs.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))
      }

      <h2>How this page is maintained</h2>
      <p>
        Every figure above comes from the official Steam listing (App {GAME_FACTS.steamAppId}) or the
        publisher's release announcement, last checked {GAME_FACTS.lastVerified}. Console-store
        details we cannot open and verify directly are described as such.
        {
          IS_RELEASED
            ? ' Now that the game has shipped, this page reports what actually released rather than what was planned, including any day-one patch notes worth knowing about.'
            : ` After ${GAME_FACTS.releaseDate} this page switches from "what is planned" to "what shipped", including any day-one patch notes worth knowing about.`
        }
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/game-info/"
        class="rounded-lg bg-ember-600 px-5 py-3 font-semibold text-ash-950 transition-colors hover:bg-ember-500"
      >
        Confirmed game info
      </a>
      <a
        href="/download/"
        class="rounded-lg border border-ash-600 px-5 py-3 font-semibold text-ash-100 transition-colors hover:border-ash-400 hover:bg-ash-800"
      >
        Download & PC requirements
      </a>
    </div>
  </section>
</BaseLayout>
