---
import { WIKI_SECTIONS } from '../data/site';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<nav
  aria-label="Beast of Reincarnation wiki sections"
  class="rounded-xl border border-ash-800 bg-ash-900/40 p-4"
>
  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-ash-500">
    Explore the Beast of Reincarnation Wiki
  </p>
  <ul class="flex flex-wrap gap-2">
    {
      WIKI_SECTIONS.map((section) => (
        <li>
          <a
            href={section.href}
            aria-current={active === section.href ? 'page' : undefined}
            class:list={[
              'inline-flex rounded-full border px-3 py-1.5 text-sm transition-colors',
              active === section.href
                ? 'border-ember-500 bg-ember-950/60 text-ember-300'
                : 'border-ash-700 text-ash-300 hover:border-ember-500 hover:text-ember-400',
            ]}
          >
            {section.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
