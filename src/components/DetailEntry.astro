---
// One merged reference entry on a hub page (boss, chapter, blade, collectible, skill tree).
// These used to be separate thin pages; their old URLs 301 to the hub (see public/_redirects)
// and internal links point at the `id` anchor rendered here.
import type { SectionFact } from '../data/section-pages';

interface Props {
  id: string;
  title: string;
  intro?: string;
  facts: readonly SectionFact[];
  steps?: readonly string[];
  stepsTitle?: string;
  note?: string;
  links?: readonly { href: string; label: string }[];
  level?: 2 | 3;
}

const { id, title, intro, facts, steps = [], stepsTitle = 'What to do', note, links = [], level = 2 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---

<article id={id} class="scroll-mt-24 rounded-xl border border-ash-800 bg-ash-900/40 p-6">
  <Heading class="font-display text-2xl font-bold text-ash-50">{title}</Heading>
  {intro && <p class="mt-3 leading-relaxed text-ash-300">{intro}</p>}
  {
    facts.length > 0 && (
      <div class="mt-5 overflow-hidden rounded-lg border border-ash-800">
        <table class="w-full text-left text-sm">
          <tbody>
            {facts.map((fact) => (
              <tr class="border-t border-ash-800 first:border-t-0">
                <th scope="row" class="w-2/5 bg-ash-900/60 px-4 py-2.5 font-medium text-ash-200">{fact.label}</th>
                <td class="px-4 py-2.5 text-ash-300">{fact.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {
    steps.length > 0 && (
      <>
        <p class="mt-5 font-display text-sm font-semibold uppercase tracking-wide text-ash-400">{stepsTitle}</p>
        <ol class="mt-3 space-y-2.5 text-ash-300">
          {steps.map((step, index) => (
            <li class="flex gap-3">
              <span class="font-display font-bold text-ember-400">{index + 1}.</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      </>
    )
  }
  {note && <p class="mt-4 text-sm leading-relaxed text-ash-400">{note}</p>}
  {
    links.length > 0 && (
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {links.map((l) => (
          <a href={l.href} class="text-ember-400 hover:underline">{l.label} →</a>
        ))}
      </p>
    )
  }
</article>
