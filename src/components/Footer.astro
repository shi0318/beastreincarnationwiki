---
import { SITE, NAV, WIKI_SECTIONS, FOOTER_LINKS } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-ash-800 bg-ash-900/40">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-8 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <p class="font-display text-lg font-semibold text-ash-50">{SITE.name}</p>
        <p class="mt-2 text-sm leading-relaxed text-ash-400">{SITE.description}</p>
      </div>

      <div class="flex gap-16">
        <nav aria-label="Guides">
          <p class="mb-3 font-display text-xs font-semibold uppercase tracking-wide text-ash-500">
            Guides
          </p>
          <ul class="flex flex-col gap-2 text-sm">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-ash-400 transition-colors hover:text-ember-400"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Wiki sections">
          <p class="mb-3 font-display text-xs font-semibold uppercase tracking-wide text-ash-500">
            Wiki Sections
          </p>
          <ul class="flex flex-col gap-2 text-sm">
            {
              WIKI_SECTIONS.map((section) => (
                <li>
                  <a
                    href={section.href}
                    class="text-ash-400 transition-colors hover:text-ember-400"
                  >
                    {section.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <nav aria-label="Site">
          <p class="mb-3 font-display text-xs font-semibold uppercase tracking-wide text-ash-500">
            Site
          </p>
          <ul class="flex flex-col gap-2 text-sm">
            {
              FOOTER_LINKS.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-ash-400 transition-colors hover:text-ember-400"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div class="mt-8 border-t border-ash-800 pt-6 text-xs leading-relaxed text-ash-500">
      <p>
        &copy; {year} {SITE.name}. This is an unofficial fan-made resource and is
        not affiliated with or endorsed by the game's developers or publishers.
        All trademarks are the property of their respective owners.
      </p>
    </div>
  </div>
</footer>
